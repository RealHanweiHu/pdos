# Copy only after choosing this independent environment; do not inherit the old .env.
# Application: non-owner, non-superuser, non-BYPASSRLS.
DATABASE_URL=
# Authentication: SELECT only on login_sessions, no business table access.
AUTH_DATABASE_URL=
# Metadata-only dispatcher role; no business-table DML or SELECT.
DISPATCH_DATABASE_URL=
# Migration credentials: separate process only; never provided to AI workers.
MIGRATION_DATABASE_URL=
# Next.js server-side BFF endpoint. The API requires an actual server-bound session.
PDOS_NEXT_API_URL=http://127.0.0.1:8898
# Synthetic local preview sessions are generated by tools/local_environment.py.
# Optional server-owned metadata file shared by API and Worker. No credentials in this file.
# See docs/runbooks/pdos-next-tenant-model-runtime.md and config/tenant-runtime.example.json.
# Model keys stay in Alibaba Cloud KMS; access identity uses the SDK credential chain/ECS RAM role.
# Optional research block also binds Searx and a shared private artifact directory.
PDOS_TENANT_RUNTIME_CONFIG=
