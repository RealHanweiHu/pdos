{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "format_version": 1,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer"
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "purpose"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "visibility": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "visibility"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "type": "object",
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "origin": {
          "type": "string"
        },
        "writer_id": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_value": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "claim_states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        }
      },
      "required": [
        "item_id",
        "version",
        "kind",
        "content",
        "source_refs",
        "origin",
        "human_value",
        "removed"
      ],
      "additionalProperties": false
    },
    "research_memory": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "row_count": {
          "type": "integer"
        },
        "ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        }
      },
      "required": [
        "job_id",
        "status",
        "snapshots",
        "row_count"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "research": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/research_memory"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "summary",
        "unfinished",
        "research"
      ],
      "additionalProperties": false
    },
    "memory_turn": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "historical_outcome": {
          "$ref": "#/$defs/outcome"
        },
        "outcome_state": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "original_record": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "run_id",
            "session_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "goal",
        "status",
        "historical_outcome",
        "outcome_state",
        "sources",
        "original_record"
      ],
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "root_goal": {
          "type": "string"
        },
        "root_run_id": {
          "type": "string"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memory_turn"
          }
        },
        "next_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "fact_policy": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "root_goal",
        "root_run_id",
        "turns",
        "next_before",
        "fact_policy"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "category_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "entry_kind": {
          "type": "string"
        },
        "target_kind": {
          "type": "string"
        },
        "baseline_product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_definition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": "integer"
        },
        "baseline_definition_revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "private_source_count": {
          "type": "integer"
        },
        "context_hint": {
          "type": "boolean"
        },
        "context_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "maturity": {
          "type": "object",
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        },
        "submission": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        },
        "decision": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        }
      },
      "required": [
        "id",
        "category_id",
        "owner_id",
        "revision",
        "status",
        "visibility",
        "title",
        "brief",
        "entry_kind",
        "target_kind",
        "items",
        "source_refs",
        "context_refs",
        "maturity"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "visibility": {
          "type": "string"
        },
        "current_facts": {
          "$ref": "#/$defs/project_current_facts"
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "visibility"
      ],
      "additionalProperties": false
    },
    "work_state": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_goal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "run_id",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "current_goal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "run_id",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "run_id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "focus_objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "version": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "run_id": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "version",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "receipt_id": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              }
            },
            "required": [
              "receipt_id",
              "operation",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "completed_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "category",
                  "domain",
                  "snapshot",
                  "verification_preparation"
                ]
              },
              "operation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "adopted",
                  "cancelled",
                  "pending",
                  "unavailable"
                ]
              },
              "receipt_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "event_id",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "version",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "citation_directory": {
          "type": "object",
          "properties": {
            "tool": {
              "const": "assistant.citations.read"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "tool",
            "has_more",
            "next_cursor"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "context_incomplete": {
          "type": "boolean"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_preferences": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "current",
                "same_category"
              ]
            },
            "include_customer_private": {
              "type": "boolean"
            }
          },
          "required": [
            "scope",
            "include_customer_private"
          ],
          "additionalProperties": false
        },
        "search_context": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "personal",
                "category",
                "project",
                "proposal"
              ]
            },
            "label": {
              "type": "string"
            },
            "scoped": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "label",
            "scoped"
          ],
          "additionalProperties": false
        },
        "context_selection": {
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1,
              "default": 1,
              "title": "Version",
              "type": "integer"
            },
            "status": {
              "enum": [
                "available",
                "unavailable"
              ],
              "title": "Status",
              "type": "string"
            },
            "focus": {
              "anyOf": [
                {
                  "$ref": "#/$defs/context_correction_SelectedSource"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version_mode": {
              "enum": [
                "any",
                "current",
                "fixed"
              ],
              "title": "Version Mode",
              "type": "string"
            },
            "versions": {
              "items": {
                "$ref": "#/$defs/context_correction_SelectedSource"
              },
              "title": "Versions",
              "type": "array"
            },
            "sources": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/context_correction_SelectedSource"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sources"
            }
          },
          "required": [
            "status",
            "focus",
            "version_mode",
            "versions",
            "sources"
          ],
          "title": "ContextSelection",
          "type": "object"
        }
      },
      "required": [
        "version",
        "revision",
        "session_id",
        "root_goal",
        "current_goal",
        "constraints",
        "exclusions",
        "focus_objects",
        "completed",
        "completed_count",
        "candidates",
        "unfinished",
        "questions",
        "skills",
        "citations",
        "notes",
        "estimated_tokens",
        "context_incomplete",
        "missing"
      ],
      "additionalProperties": false
    },
    "context_correction_SelectedSource": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "enum": [
            "artifact",
            "knowledge",
            "issue",
            "capa",
            "change",
            "external_wait",
            "supply",
            "build",
            "test_run"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "object_id": {
          "format": "uuid",
          "title": "Object Id",
          "type": "string"
        },
        "source_revision": {
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "category_id": {
          "format": "uuid",
          "title": "Category Id",
          "type": "string"
        },
        "product_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        },
        "project_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "proposal_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "private": {
          "title": "Private",
          "type": "boolean"
        },
        "customer_original": {
          "title": "Customer Original",
          "type": "boolean"
        }
      },
      "required": [
        "source_type",
        "source_id",
        "object_id",
        "source_revision",
        "content_hash",
        "category_id",
        "title",
        "private",
        "customer_original"
      ],
      "title": "SelectedSource",
      "type": "object"
    },
    "project_current_Commitment": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/project_current_Link"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "promisor_id": {
          "title": "Promisor Id",
          "type": "string"
        },
        "recipient_id": {
          "title": "Recipient Id",
          "type": "string"
        },
        "promised_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promised At"
        },
        "fulfilled": {
          "title": "Fulfilled",
          "type": "boolean"
        }
      },
      "required": [
        "reference",
        "task_id",
        "promisor_id",
        "recipient_id",
        "fulfilled"
      ],
      "title": "Commitment",
      "type": "object"
    },
    "project_current_Gate": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Id"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/project_current_Link"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_current": {
          "default": false,
          "title": "Review Current",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/project_current_GateCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "state"
      ],
      "title": "Gate",
      "type": "object"
    },
    "project_current_GateCheck": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
