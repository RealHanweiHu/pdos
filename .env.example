# ============================================================
# PDOS 本地开发环境变量模板
# 用法: cp .env.example .env 然后填写标 [必填] 的项
# .env 不入库（.gitignore 已配置）
# ============================================================

# ---------- 数据库（本地 docker compose 自带，默认值可直接用） ----------
# 本地: docker compose up -d postgres 后即可连接（pgvector/pg16 镜像）
DATABASE_URL=postgresql://pdos:pdos@localhost:55432/pdos
# 测试库独立隔离（吸取 CEHub/GoodJob 测试污染教训）
TEST_DATABASE_URL=postgresql://pdos:pdos@localhost:55432/pdos_test
# 仅在默认端口被其他本地项目占用时覆盖，并同步调整上面两个 URL
PDOS_POSTGRES_PORT=55432

# ---------- LLM Gateway [Sprint 2 前必填, Sprint 0/1 可留空] ----------
# 多供应商可选: anthropic / openai / deepseek / glm / minimax
# 除 anthropic 走原生协议外, 其余全部走 OpenAI 兼容协议(base_url 可换)
# base_url 以各家官方文档为准, 下面给常用预设:
#   deepseek:  https://api.deepseek.com          模型如 deepseek-chat / deepseek-reasoner
#   glm(智谱): https://open.bigmodel.cn/api/paas/v4   模型如 glm-4 系列
#   minimax:   见 MiniMax 官方 OpenAI 兼容端点        模型如 abab/MiniMax-Text 系列
#   openai:    https://api.openai.com/v1
# 默认供应商 = MiniMax 国内版(minimax.cn); base_url 与模型名以官方文档实时核对
PDOS_LLM_PROVIDER=minimax
PDOS_LLM_BASE_URL=https://api.minimaxi.com/v1
PDOS_LLM_API_KEY=
PDOS_LLM_MODEL=MiniMax-M1

# 备选供应商凭据(填了 key 的供应商才会出现在租户设置的模型下拉中):
# PDOS_LLM_DEEPSEEK_API_KEY=
# PDOS_LLM_GLM_API_KEY=
# PDOS_LLM_OPENAI_API_KEY=

# anthropic 原生协议时改用（并把 PROVIDER 设为 anthropic, BASE_URL 留空）:
# ANTHROPIC_API_KEY=

# 每租户每日 token 预算上限（超限静默降级, 不阻塞业务）
PDOS_AI_DAILY_TOKEN_BUDGET=2000000
# 换模型/换供应商必须重跑 golden-case 评测集后才允许切生产默认(执行计划 §11)

# ---------- 认证 ----------
# 生成: openssl rand -base64 32
JWT_SECRET=dev-only-change-this-secret-now-123
JWT_ISSUER=pdos-api
JWT_AUDIENCE=pdos-web
JWT_ACCESS_TOKEN_MINUTES=30

# ---------- 对象存储（本地 MinIO, compose 自带, 默认值可直接用） ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pdos-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- 钉钉（Sprint 5 才需要, 先留空） ----------
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_CORP_ID=
# DINGTALK_AGENT_ID=
