# ============================================================
# PDOS 本地开发环境变量模板
# 用法: cp .env.example .env 然后填写标 [必填] 的项
# .env 不入库（.gitignore 已配置）
# ============================================================

# ---------- 数据库（本地 docker compose 自带，默认值可直接用） ----------
# 本地: docker compose up -d postgres 后即可连接（pgvector/pg16 镜像）
DATABASE_URL=postgresql://pdos:pdos@localhost:55432/pdos
# 测试库独立隔离（吸取 CEHub/GoodJob 测试污染教训）
TEST_DATABASE_URL=postgresql://pdos:pdos@localhost:55432/pdos_test
# 仅在默认端口被其他本地项目占用时覆盖，并同步调整上面两个 URL
PDOS_POSTGRES_PORT=55432

# ---------- LLM Gateway [Sprint 2 前必填, Sprint 0/1 可留空] ----------
# 候选预设（供应商 | 协议 | base_url | 默认候选模型）:
#   minimax | openai-compatible | https://api.minimaxi.com/v1 | MiniMax-M3
#   deepseek | openai-compatible | https://api.deepseek.com | deepseek-v4-flash
#   glm | openai-compatible | https://open.bigmodel.cn/api/paas/v4 | glm-5.2
#   openai | openai-compatible | https://api.openai.com/v1 | gpt-5.1
#   anthropic | native | SDK default | claude-sonnet-5
#   openrouter | openai-compatible | https://openrouter.ai/api/v1 | openai/gpt-5.2
#   opencode_go | openai-compatible | https://opencode.ai/zen/go/v1 | deepseek-v4-flash
# 当前默认供应商为 MiniMax 国内版；端点和模型已预置，只需填写 API key
PDOS_LLM_PROVIDER=minimax
PDOS_LLM_BASE_URL=https://api.minimaxi.com/v1
PDOS_LLM_API_KEY=
PDOS_LLM_MODEL=MiniMax-M3
# 应用侧预算显式采用：默认 legacy。完整前提见 docs/runbooks/application-budget-adoption.md。
# budgeted 必须同时指定已批准 profile、真实计量发布包绝对路径和独立 SHA-256。
# 四个主动入口已有创建时预算；真实计量与完整切换条件仍须满足。
# 小Pai自动搜索/公开原文读取也要求budgeted运行；legacy仅支持普通模型回复。
PDOS_APPLICATION_MODEL_BUDGET_MODE=legacy
PDOS_APPLICATION_MODEL_BUDGET_PROFILE=
PDOS_APPLICATION_MODEL_METER_PATH=
PDOS_APPLICATION_MODEL_METER_SHA256=
# 待批准的品类/提案研究候选：留空保持原策略。
# 仅在明确批准并取得真实≥8000输出计量资格后设为 preproject_research。
PDOS_APPLICATION_PREPROJECT_BUDGET_PROFILE=
# Enable only with budgeted application mode and a running application worker.
# Web BFF switches Chat submission to persisted requests; no automatic model-mode fallback.
PDOS_AI_CHAT_ASYNC=false
PDOS_APPLICATION_POLL_SECONDS=1

# 备选供应商只需填写对应 key；通过 golden-case 后才进入租户模型下拉
# 当前默认供应商继续使用上面的 PDOS_LLM_API_KEY，无需重复填写
PDOS_LLM_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
PDOS_LLM_MINIMAX_MODEL=MiniMax-M3
PDOS_LLM_MINIMAX_API_KEY=

PDOS_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
PDOS_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
PDOS_LLM_DEEPSEEK_API_KEY=

PDOS_LLM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PDOS_LLM_GLM_MODEL=glm-5.2
PDOS_LLM_GLM_API_KEY=

PDOS_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
PDOS_LLM_OPENAI_MODEL=gpt-5.1
PDOS_LLM_OPENAI_API_KEY=

PDOS_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
PDOS_LLM_ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

PDOS_LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PDOS_LLM_OPENROUTER_MODEL=openai/gpt-5.2
PDOS_LLM_OPENROUTER_API_KEY=

# OpenCode Go 第一版仅开放官方 /chat/completions 模型；/messages 与 /responses 暂不接入
PDOS_LLM_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
PDOS_LLM_OPENCODE_GO_MODEL=deepseek-v4-flash
PDOS_LLM_OPENCODE_GO_API_KEY=

# 每租户每日 token 预算上限（超限静默降级, 不阻塞业务）
PDOS_AI_DAILY_TOKEN_BUDGET=2000000
# 换模型/换供应商必须重跑 golden-case 评测集后才允许切生产默认(执行计划 §11)

# ---------- 认证 ----------
# 生成: openssl rand -base64 32
JWT_SECRET=dev-only-change-this-secret-now-123
JWT_ISSUER=pdos-api
JWT_AUDIENCE=pdos-web
JWT_ACCESS_TOKEN_MINUTES=30
# Next.js BFF 访问 FastAPI 的仅服务端地址（不会暴露到浏览器）
PDOS_API_INTERNAL_URL=http://127.0.0.1:8000

# ---------- 对象存储（本地 MinIO, compose 自带, 默认值可直接用） ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pdos-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# 确定性跨项目预测传播；阶段验证后再显式启用，不调用模型或外发。
# app-role 进程：python -m scripts.run_schedule_propagation（--once 单轮）
PDOS_SCHEDULE_PROPAGATION_ENABLED=false
PDOS_SCHEDULE_PROPAGATION_SCAN_SECONDS=60

# ---------- V1 确定性风险候选/提醒调度（独立 app-role 进程） ----------
# 启动与排障见 docs/runbooks/v1-reminder-scheduler.md；周期单位为秒
PDOS_REMINDER_SCAN_SECONDS=60
# 钉钉个人提醒静默窗口为 Asia/Shanghai；日上限按租户内收件人计算
PDOS_REMINDER_QUIET_HOURS=21:00-08:00
PDOS_REMINDER_DAILY_DM_CAP=50
PDOS_PUBLIC_BASE_URL=http://localhost:3000
# 关闭时只落 manual outbox，零外发；真实钉钉验收与启用仍须明确授权
PDOS_DINGTALK_DELIVERY_ENABLED=false

# ---------- 钉钉（Sprint 5 才需要, 先留空） ----------
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_CORP_ID=
# DINGTALK_AGENT_ID=

# Agent独立预算采用：dispatcher和executor使用相同模式/profile。
# dispatcher不需要计量资产或模型密钥；executor必须有真实发布包和独立摘要。
# 当前保持legacy；新事件run创建时冻结预算，旧未绑定运行不自动补新额度。
PDOS_AGENT_MODEL_BUDGET_MODE=legacy
PDOS_AGENT_MODEL_BUDGET_PROFILE=
PDOS_AGENT_MODEL_METER_PATH=
PDOS_AGENT_MODEL_METER_SHA256=
# 可选新事件工具循环：独立用途资格发布包，dispatcher/executor必须读取同一版本。
# 留空保持原固定流程；通用模型和输入计量资格不能替代此用途资格。
PDOS_AGENT_LOOP_QUALIFICATION_PATH=
PDOS_AGENT_LOOP_QUALIFICATION_SHA256=

# Route test-plan suggestion UI requests into the configured application worker.
PDOS_AI_TEST_PLAN_ASYNC=false

# Enable background Excel mapping after the application worker and private staging reads are ready.
PDOS_AI_REPORT_IMPORT_ASYNC=false

# 产品研究：SearXNG GET /search端点，须启用JSON；作为网络搜索的最终兜底。
# 不包含凭据、查询参数或租户资料；不自动选择第三方公共实例。
PDOS_RESEARCH_SEARCH_ENDPOINT=
# 公开来源解析：system默认；cloudflare_doh使用固定1.1.1.1的验证TLS解析，仍拒绝全部非公开地址。
PDOS_RESEARCH_DNS_MODE=system
# 本地兜底：设端点为 http://127.0.0.1:8888/search，并用随机值填写以下密钥。
# docker compose --profile research up -d searxng
PDOS_SEARXNG_SECRET=
# Tavily 网络搜索（2026-10-05 用户授权）：查询词出站到 api.tavily.com；留空不启用。
PDOS_RESEARCH_TAVILY_API_KEY=
# Firecrawl：搜索回退与公开网页正文读取，查询词/公开URL出站 api.firecrawl.dev。
PDOS_RESEARCH_FIRECRAWL_API_KEY=
# 订阅采集默认关闭；启用前完成阶段验收并单独运行采集worker。
PDOS_RESEARCH_SUBSCRIPTIONS_ENABLED=false
# 站内爬虫默认关闭；启用后以 python -m scripts.run_research_crawler 单独运行。
# 仅沿已登记来源的站内链接爬取，遵守 robots.txt，快照进入本地研究索引。
PDOS_RESEARCH_CRAWLER_ENABLED=false
PDOS_RESEARCH_CRAWL_MAX_DEPTH=3
PDOS_RESEARCH_CRAWL_MAX_FRONTIER=500

# 规则知识候选后台整理（无模型调用）；阶段验收后再启用 app-role 进程。
# python -m scripts.run_knowledge_candidates --once
PDOS_KNOWLEDGE_CANDIDATES_ENABLED=false

# Optional offline field photo/voice extraction. Defaults off; no automatic model downloads.
# Install server extra: uv sync --extra capture. Tesseract 5 is a system dependency.
# Provision read-only local model directories, then fingerprint their exact files with:
# python -m app.domain.field_recognition_engine --fingerprint /absolute/model/directory
# OCR directory must include eng.traineddata, chi_sim.traineddata and Tesseract configs.
# Speech directory must contain a complete converted faster-whisper multilingual model.
# Run separately: PYTHONPATH=. python scripts/run_capture_worker.py
# Receipt text stays unreviewed until a human adopts it into a draft and confirms business input.
PDOS_CAPTURE_RECOGNITION_ENABLED=false
# PDOS_CAPTURE_TESSERACT_PATH=/usr/bin/tesseract
# PDOS_CAPTURE_TESSDATA_DIR=/models/tessdata
# PDOS_CAPTURE_TESSDATA_SHA256=<directory fingerprint>
# PDOS_CAPTURE_WHISPER_DIR=/models/whisper
# PDOS_CAPTURE_WHISPER_SHA256=<directory fingerprint>

# 周期会议本地自动生成：默认关闭；阶段验收后独立运行 PYTHONPATH=. python scripts/run_meeting_generation.py。
# 每个周期另需具名确认期限/提前天数；此进程不预约外部会议或发送邀请。
PDOS_MEETING_GENERATION_ENABLED=false
PDOS_MEETING_GENERATION_SCAN_SECONDS=60

# Independent conference queue: enable only for explicitly authorized provider operations.
PDOS_DINGTALK_CONFERENCE_ENABLED=false

# Tencent enterprise REST API: scoped tenant, named identities and independent outbound flag.
# Configure secrets through the deployment secret store, never a browser form.
PDOS_TENCENT_MEETING_ENABLED=false
# PDOS_TENCENT_MEETING_TENANT_ID=
# PDOS_TENCENT_MEETING_APP_ID=
# PDOS_TENCENT_MEETING_SDK_ID=
# PDOS_TENCENT_MEETING_KEY_ID=
# PDOS_TENCENT_MEETING_SECRET=

# Scoped external API. Keep disabled until stage integration and environment authorization.
PDOS_OPEN_API_ENABLED=false

# Webhook delivery remains off until stage acceptance and named endpoint activation.
PDOS_WEBHOOK_DELIVERY_ENABLED=false
# Configure a durable base64-encoded 32-byte encryption key before endpoint creation.
# PDOS_WEBHOOK_ENCRYPTION_KEY=<base64-32-byte-key>
# 全部 Agent 使用 LangGraph + Temporal。本地 scripts/dev.sh 创建独立状态服务；
# 外部环境须显式填写四项（状态库不可复用业务库或模型资格）。
PDOS_AGENT_RUNTIME_DATABASE_URL=
PDOS_AGENT_RUNTIME_DB_MARKER=
PDOS_TEMPORAL_ADDRESS=
PDOS_TEMPORAL_NAMESPACE=
