    && row.ref.id === fixed?.id && row.ref.revision === fixed?.revision && row.ref.key == null);
  const executorId = c.executor_id ?? c.principal_id;
  const actualExecutor = before.executor_options?.find(row => row.id === executorId);
  require(before.change.change_id === changeId && before.change.project_id === c.project_id,
    "Actual Change/project differs from the reviewed target");
  require(feedback && actualObject && actualExecutor,
    "Actual feedback/configuration/executor option unavailable; inspect the current UI");
  require(before.policy?.current === true && before.policy.nature === "synthetic",
    "This template requires the actual current declared local synthetic policy");
  const unknownBefore = before.change.request.assessments?.at(-1)?.unknown ?? [];
  const priorSelectionIds = new Set(before.selections.map(row => row.id));
  await form().waitFor({ timeout: 60000 });

  // Named role lookup is deliberate: nested labels contain changing option
  // content, so exact getByLabel is unreliable for these actual controls.
  const description = (c.plan_description
    ?? "合成页面：在具名专业批准后，由所选实际人员建立所选固定配置的真实后继版本。").trim();
  const conditions = c.plan_conditions
    ?? "仅适用本次所选固定配置及明确项目\n批次保持未知，不授予生产切换或外部生效";
  const verification = (c.plan_verification
    ?? "保留原配置和原运行；使用实际新配置、新样件与独立新 Run 取得复验结果，实施记录本身不表示复验通过。").trim();
  const reason = (c.plan_reason
    ?? "合成页面：本人明确提出未来计划并决定其对本次固定范围的适用性，不把已发生处置冒充未来措施。").trim();
  if (!c.recover_material_request) {
  await form().getByRole("combobox", { name: "本项依据的实际反馈", exact: true })
    .selectOption(`${feedback.feedback.id}:${feedback.feedback.revision}`);
  await form().getByRole("combobox", { name: "未来实施类型", exact: true }).selectOption(kind);
  await form().getByRole("combobox", { name: "拟变更的实际配置", exact: true })
    .selectOption(JSON.stringify([actualObject.ref.kind, actualObject.ref.id,
      actualObject.ref.revision, actualObject.ref.key ?? null]));
  await form().getByRole("combobox", { name: "本计划项实际执行人", exact: true }).selectOption(executorId);
  await form().getByRole("textbox", { name: "未来实施意图", exact: true }).fill(description);
  await form().getByRole("textbox", { name: "适用条件（每行一项）", exact: true }).fill(conditions);
  await form().getByRole("textbox", { name: "后续复验要求", exact: true }).fill(verification);
  await form().getByRole("combobox", { name: "本项适用性判断", exact: true }).selectOption("applicable");
  await deadline().fill("");
  await form().getByRole("textbox", { name: "本项适用性判断理由", exact: true }).fill(reason);

  }
  const draftResponse = page.waitForResponse(response => at(response, "/change-execution/selection-material")
    && body(response.request())?.field_intent?.feedback?.id === c.feedback_id, { timeout: 60000 });
  const artifactResponse = page.waitForResponse(response => at(response, "/commands")
    && body(response.request())?.operation === "evidence.artifact.register", { timeout: 60000 });
  const candidateResponse = page.waitForResponse(response => at(response, "/change-execution/selection-material")
    && body(response.request())?.change_id === changeId
    && body(response.request())?.source?.kind === "artifact", { timeout: 60000 });
  await form().getByRole("button", { name: c.recover_material_request ? "按原请求核对材料登记" : "登记本项未来计划材料并读取适用性候选", exact: true }).click();
  const drafted = await draftResponse;
  require(drafted.status() === 200, `Actual material draft failed: ${drafted.status()}`);
  const draft = await drafted.json();
  require(draft.stage === "material_draft"
    && draft.material.schema_version === "pdos-field-change-selection-v1"
    && draft.material.valid_until === null
    && draft.material.nature === before.policy.nature
    && draft.material.status === "applicable"
    && draft.material.decider_id === c.principal_id
    && draft.material.executor_id === executorId
    && same(draft.material.feedback, feedback.feedback)
    && draft.material.item.intent.description === description
    && draft.material.item.verification_requirement === verification,
  "Server draft did not retain the actual declared plan and fixed Field basis");
  const registered = await artifactResponse;
  require(registered.status() === 200, `Actual source registration failed: ${registered.status()}`);
  const artifactReceipt = await registered.json();
  require(artifactReceipt.operation === "evidence.artifact.register" && artifactReceipt.subject_type === "artifact",
    "Plan material did not use the native source registration owner");
  const candidateResult = await candidateResponse;
  require(candidateResult.status() === 200, `Actual applicability candidate failed: ${candidateResult.status()}`);
  const candidate = await candidateResult.json();
  require(candidate.command.operation === operation && candidate.command.payload.change_id === changeId
    && candidate.command.payload.action.kind === "field_intent"
    && candidate.command.payload.source.id === artifactReceipt.subject_id
    && same(candidate.material, draft.material), "Actual candidate did not bind the newly registered source");
  const workspace = await get(path + "/workspace");
  const actualSource = workspace.sources?.find(row => row.id === artifactReceipt.subject_id
    && row.revision === artifactReceipt.subject_revision);
  require(actualSource?.status === "active" && actualSource.original_id === null
    && actualSource.content === draft.material_content
    && actualSource.visibility === draft.artifact_payload.visibility
    && same(JSON.parse(actualSource.content), draft.material),
    "Native registered source could not be read back as the actual plan material");
  const previewResponse = page.waitForResponse(response => at(response, "/commands/preview")
    && body(response.request())?.operation === operation, { timeout: 60000 });
  await orders().getByRole("button", { name: "读取本项具名适用性决定的实质预览", exact: true }).click();
  const previewed = await previewResponse;
  require(previewed.status() === 200, `Actual T2 preview failed: ${previewed.status()}`);
  const preview = await previewed.json();
  require(preview.write_tier === "T2" && preview.named_decision === true && preview.expires_at === null
    && typeof preview.command.payload.approval_token === "string"
    && same(preview.review.after.material, draft.material), "Actual named T2/null deadline preview is incomplete");
  const dialog = () => page.getByRole("dialog").filter({ has: page.getByRole("heading", {
    name: "具名决定本项适用性", exact: true,
  }) });
  await dialog().waitFor({ timeout: 60000 });
  await dialog().getByText(/^有效至 未另设截止时点。/).waitFor();

  let committedReceipt = null, committedCommand = null, replayedReceipt = null;
  let responseLossExercised = false, refreshPostCount = null, exactReplay = null;
  const loseResponse = c.lose_selection_response === true;
  const pattern = "**/commands";
  let responseWasLost = false;
  const loseOnce = async route => {
    const request = route.request(), command = body(request);
    if (request.method() !== "POST" || command?.operation !== operation
      || command.payload?.change_id !== changeId || responseWasLost) return route.continue();
    responseWasLost = true;
    const response = await route.fetch();
    if (response.status() !== 200) { await route.fulfill({ response }); return; }
    committedReceipt = await response.json();
    committedCommand = command; // Private in-memory comparison only; never returned or logged.
    require(committedReceipt.operation === operation && committedReceipt.subject_type === "change_selection_fact",
      "The intercepted real server response is not a selection Receipt");
    await route.fulfill({ status: 503, contentType: "application/json", body: JSON.stringify({
      code: "UPSTREAM_ERROR", message: "本地演练：服务端已保存，页面本次响应丢失。",
    }) });
  };
  if (loseResponse) await page.route(pattern, loseOnce);
  try {
    const resultResponse = page.waitForResponse(response => at(response, "/commands")
      && body(response.request())?.operation === operation, { timeout: 60000 });
    await dialog().getByRole("button", { name: "以当前具名人决定本项适用性", exact: true }).click();
    const executed = await resultResponse;
    if (!loseResponse) {
      require(executed.status() === 200, `Actual named T2 save failed: ${executed.status()}`);
      committedReceipt = await executed.json();
    } else {
      require(executed.status() === 503 && committedReceipt && responseWasLost,
        "Response-loss exercise did not follow a real successful save");
      await orders().getByRole("button", { name: "核对并恢复同一原请求", exact: true }).waitFor({ timeout: 60000 });
      await page.unroute(pattern, loseOnce);
      let postCount = 0;
      const track = request => { if (request.method() === "POST") postCount++; };
      page.on("request", track);
      try {
        await page.reload({ waitUntil: "domcontentloaded" });
        await fieldRoot().getByRole("region", { name: "反馈列表", exact: true }).waitFor({ timeout: 60000 });
        // A mounted retained request is already the same exact Field/Change.
        // If the outer selection was not restored, reselect it through its real
        // card and Change combobox; this performs reads only, never a new plan.
        if (!await continuation().isVisible()) {
          const actualFeedback = (await get(path + "/field-feedback")).feedbacks
            .find(row => row.id === c.feedback_id);
          require(actualFeedback, "Actual Field record is unavailable after refresh");
          const card = fieldRoot().getByRole("article").filter({ has: page.getByRole("heading", {
            name: actualFeedback.title, exact: true,
          }) });
          require(await card.count() === 1, "Observe the actual unique Field card before recovery");
          await card.getByRole("button", { name: "查看变更接续", exact: true }).click();
        }
        const choice = continuation().getByRole("combobox", { name: "选择实际变更", exact: true });
        await choice.waitFor({ timeout: 60000 });
        if (await choice.inputValue() !== changeId) await choice.selectOption(changeId);
        await orders().getByRole("button", { name: "核对并恢复同一原请求", exact: true }).waitFor({ timeout: 60000 });
        require(await choice.inputValue() === changeId && postCount === 0,
          "Refresh or reselect automatically submitted a business POST");
        refreshPostCount = postCount;
      } finally { page.off("request", track); }
      const retried = page.waitForResponse(response => at(response, "/commands")
        && body(response.request())?.operation === operation, { timeout: 60000 });
      await orders().getByRole("button", { name: "核对并恢复同一原请求", exact: true }).click();
      const replay = await retried;
      require(replay.status() === 200, `Explicit original-request replay failed: ${replay.status()}`);
      exactReplay = same(body(replay.request()), committedCommand);
      replayedReceipt = await replay.json();
      require(exactReplay && replayedReceipt.id === committedReceipt.id,
        "Recovery changed the original key/token/payload or produced a different Receipt");
      responseLossExercised = true;
    }
  } finally { if (loseResponse) await page.unroute(pattern, loseOnce); }
  // The outer Field view intentionally refreshes after a save and may unmount
  // transient notices. Verify the durable saved plan, not a disappearing toast.
  const after = await context();
  const saved = after.selections.filter(row => row.id === committedReceipt.subject_id);
  const matchingItem = after.selections.filter(row => row.item.id === draft.material.item.id);
  require(saved.length === 1 && matchingItem.length === 1 && !priorSelectionIds.has(saved[0].id)
    && saved[0].basis_kind === "field_intent" && saved[0].receipt_id === committedReceipt.id
    && saved[0].current === true && saved[0].source_status === "current" && saved[0].missing.length === 0
    && saved[0].status === "applicable" && saved[0].valid_until === null
    && same(saved[0].feedback, feedback.feedback)
    && saved[0].executor_id === executorId && same(saved[0].item, draft.material.item),
  "GET did not return exactly one actual saved Field selection with its native Receipt");
  require(after.change.revision === before.change.revision
    && same(after.change.request.orders, before.change.request.orders)
    && same(after.change.request.assessments?.at(-1)?.unknown ?? [], unknownBefore),
  "A selection unexpectedly advanced Change/approval/implementation or erased retained unknowns");
  await orders().getByText(description, { exact: true }).first().waitFor({ timeout: 60000 });
  return {
    passed: true, change_id: changeId, feedback_id: c.feedback_id,
    artifact_receipt: artifactReceipt.id, source_id: artifactReceipt.subject_id,
    selection_id: saved[0].id, selection_receipt: committedReceipt.id,
    selection_revision: saved[0].revision, named_t2: true, expires_at: preview.expires_at,
    actual_field_origin: true, future_plan_separate_from_response: true,
    response_loss_exercised: responseLossExercised,
    refresh_posts: refreshPostCount, original_command_and_receipt_replayed: exactReplay,
    retained_unknown_count: unknownBefore.length, model_calls: 0,
  };
}
)(page);
