  "function": {
    "source": "pdos-next/server/migrations/schema_s0_0407.py",
    "line": 3,
    "security": "invoker (no SECURITY DEFINER)",
    "sql": "CREATE OR REPLACE FUNCTION public.lifecycle_reference_gate()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\n      DECLARE payload JSONB; old_payload JSONB; p UUID; t UUID; c UUID;\n      BEGIN\n        IF TG_OP='DELETE' THEN payload=to_jsonb(OLD); ELSE payload=to_jsonb(NEW); END IF;\n        IF TG_OP='UPDATE' THEN\n          old_payload=to_jsonb(OLD);\n          IF ROW(payload->>'product_id',payload->>'tenant_id') IS DISTINCT FROM\n             ROW(old_payload->>'product_id',old_payload->>'tenant_id') THEN\n            RAISE EXCEPTION 'Reference scope cannot be reassigned';\n          END IF;\n        END IF;\n        -- Lifecycle receipts document retention decisions, not consuming business references.\n        IF TG_TABLE_NAME='action_receipts' AND payload->>'operation' LIKE 'evidence.lifecycle.%' THEN\n          IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n        END IF;\n        p=(payload->>'product_id')::uuid; t=(payload->>'tenant_id')::uuid;\n        c=(payload->>'category_id')::uuid;\n        IF p IS NULL THEN\n          PERFORM 1 FROM categories WHERE id=c AND tenant_id=t FOR UPDATE;\n          IF NOT FOUND THEN RAISE EXCEPTION 'Reference category gate unavailable'; END IF;\n          IF TG_OP<>'DELETE' AND EXISTS (\n            SELECT 1 FROM lifecycle_objects o WHERE o.product_id IS NULL AND o.category_id=c AND o.tenant_id=t\n            AND ((o.state->'value'->>'pending_intent_id') IS NOT NULL\n              OR o.state->'value'->>'disposition' IN ('quarantined','unknown','purged'))\n            AND position(o.id::text in payload::text)>0\n          ) THEN RAISE EXCEPTION 'Pending or isolated original prohibits new references'; END IF;\n          UPDATE categories SET lifecycle_epoch=lifecycle_epoch+1 WHERE id=c AND tenant_id=t;\n          IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n        END IF;\n        PERFORM 1 FROM products WHERE id=p AND tenant_id=t FOR UPDATE;\n        IF NOT FOUND THEN RAISE EXCEPTION 'Reference product gate unavailable'; END IF;\n        IF TG_OP<>'DELETE' AND EXISTS (\n          SELECT 1 FROM lifecycle_objects o WHERE o.product_id=p AND o.tenant_id=t\n          AND ((o.state->'value'->>'pending_intent_id') IS NOT NULL\n               OR o.state->'value'->>'disposition' IN ('quarantined','unknown','purged'))\n          AND position(o.id::text in payload::text)>0\n        ) THEN RAISE EXCEPTION 'Pending or isolated original prohibits new references'; END IF;\n        UPDATE products SET lifecycle_epoch=lifecycle_epoch+1 WHERE id=p AND tenant_id=t;\n        IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n      END $function$\n"
  },
  "category_policy": {
    "source": "pdos-next/server/migrations/schema_s0_0001.py",
    "line": 4,
    "sql": "CREATE POLICY category_scope ON \"categories\" USING (public.category_access(tenant_id,id) OR public.category_bootstrap(tenant_id,id)) WITH CHECK (tenant_id=nullif(current_setting('pdos.tenant_id',true),'')::uuid AND owner_id=public.scope_actor() AND public.scope_actor()=public.scope_requester())"
  },
