+                    raise DomainError("SOURCE_STALE", "发送前依据或受众已变化。")
+                decision = egress(
+                    session,
+                    SimpleNamespace(
+                        tenant_id=message.tenant_id, data_categories=answer.data_categories
+                    ),
+                    "dingtalk",
+                    data_categories=answer.data_categories,
+                )
