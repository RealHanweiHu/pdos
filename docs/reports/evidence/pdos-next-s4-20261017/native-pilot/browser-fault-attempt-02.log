  await page.getByRole("button", { name: "重放并核对同一原提交", exact: true }).click({ trial: true, timeout: 30000 });
  if (!intercepted || committedStatus !== 200) throw new Error("The actual successful result response was not intercepted");
  console.log(JSON.stringify({ intercepted, committedStatus, commandId, explicit_replay_required: true }));
 } finally { await page.unroute(target); }
})(page);
