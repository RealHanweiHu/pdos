 let intercepted = false, committedStatus = null, commandId = null;
 const target = "http://127.0.0.1:61740/api/v1/categories/0b1261de-e54b-4520-bd59-45764f4c56f3/commands";
 await page.route(target, async route => {
  const body = route.request().postDataJSON();
