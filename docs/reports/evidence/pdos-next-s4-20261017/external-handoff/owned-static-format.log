2928 +     "  WHEN 'manufacturing_publication_currents' THEN ARRAY['version_id']\n"
2929 +     "  WHEN 'manufacturing_publication_documents' THEN ARRAY['document_id','process_id']\n"
2930 +     "  WHEN 'native_pilot_runs' THEN "
2931 +     "ARRAY['build_id','lot_id','actual_configuration_id','engineering_configuration_id','process_id','publication_id']\n"
2932 +     "  WHEN 'native_pilot_currents' THEN ARRAY['pilot_id','latest_observation_id']\n"
2933 +     "  WHEN 'native_pilot_observations' THEN ARRAY['pilot_id','previous_observation_id']\n"
2934 +     "  WHEN 'release_packages' THEN ARRAY['previous_id']\n"
2935 +     "  WHEN 'release_package_currents' THEN ARRAY['version_id']\n"
