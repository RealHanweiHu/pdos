551  +     "ERRCODE='23514';\n"
552  +     "  END IF;\n"
553  +     " END IF;\n"
554  +     " EXECUTE format('SELECT %I FROM public.%I\n"
555  +     "  WHERE tenant_id=$1 AND category_id=$2 AND id=$3 FOR UPDATE',\n"
556  +     "                own_col,typ) INTO actual_owner USING t,c,sid;\n"
557  +     " IF actual_owner IS DISTINCT FROM expected_owner THEN\n"
558  +     "  RAISE EXCEPTION 'audience target unavailable' USING "
559  +     "ERRCODE='23514';\n"
560  +     " END IF;\n"
561  +     " IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
562  +     "END $function$\n",
563  + }
