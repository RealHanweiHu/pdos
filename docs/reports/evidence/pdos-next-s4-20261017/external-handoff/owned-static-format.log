3157 +     '"human_owner_id"}\'::jsonb;\n'
3158 +     "BEGIN\n"
3159 +     " IF TG_OP='DELETE' THEN value=to_jsonb(OLD); ELSE value=to_jsonb(NEW); END IF;\n"
3160 +     " IF TG_OP='UPDATE' AND\n"
3161 +     "   ROW(NEW.tenant_id,NEW.category_id,NEW.object_type,NEW.subject_id,NEW.owner_id)\n"
