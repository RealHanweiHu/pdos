3079 +     "CREATE OR REPLACE FUNCTION public.m3_lifecycle_row_links(t uuid, c uuid, table_name text, payload "
3080 +     "jsonb)\n"
3081 +     " RETURNS uuid[]\n"
3082 +     " LANGUAGE plpgsql\n"
3083 +     " STABLE SECURITY DEFINER\n"
3084 +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
3085 +     "AS $function$\n"
3086 +     "DECLARE links uuid[]; key text; keys text[];\n"
3087 +     "BEGIN\n"
3088 +     " links=public.m3_lifecycle_source_links(t,c,table_name,payload);\n"
3089 +     " -- Only the infrequent retention summary needs host/reverse relationships.\n"
3090 +     " -- They must not turn a source-free item INSERT into a proposal-history scan.\n"
3091 +     " keys=CASE table_name\n"
3092 +     "  WHEN 'definition_sources' THEN ARRAY['definition_id']\n"
3093 +     "  WHEN 'definition_specs' THEN ARRAY['definition_id']\n"
3094 +     "  WHEN 'proposal_items' THEN ARRAY['proposal_id']\n"
3095 +     "  WHEN 'proposal_item_versions' THEN ARRAY['proposal_id','item_id']\n"
3096 +     "  WHEN 'proposal_sources' THEN ARRAY['proposal_id']\n"
3097 +     "  WHEN 'proposal_submissions' THEN ARRAY['proposal_id']\n"
3098 +     "  WHEN 'proposal_decisions' THEN ARRAY['proposal_id','created_definition_id']\n"
3099 +     "  WHEN 'evidence_links' THEN ARRAY['target_id']\n"
3100 +     "  WHEN 'manufacturing_baseline_publications' THEN ARRAY['project_id']\n"
3101 +     "  WHEN 'manufacturing_publication_currents' THEN ARRAY['series_id']\n"
3102 +     "  WHEN 'manufacturing_publication_documents' THEN ARRAY['publication_id']\n"
3103 +     "  WHEN 'native_pilot_runs' THEN ARRAY['project_id']\n"
3104 +     "  WHEN 'native_pilot_currents' THEN ARRAY['pilot_id']\n"
3105 +     "  WHEN 'native_pilot_observations' THEN ARRAY['pilot_id']\n"
3106 +     "  WHEN 'release_packages' THEN ARRAY['project_id','series_id']\n"
3107 +     "  WHEN 'release_package_currents' THEN ARRAY['series_id']\n"
3108 +     "  WHEN 'release_decisions' THEN ARRAY['package_id']\n"
3109 +     "  WHEN 'release_policy_facts' THEN ARRAY['project_id','series_id']\n"
3110 +     "  WHEN 'release_policy_currents' THEN ARRAY['series_id']\n"
3111 +     "  ELSE ARRAY[]::text[] END;\n"
3112 +     " FOREACH key IN ARRAY keys LOOP\n"
3113 +     "  IF payload->>key IS NOT NULL THEN links=array_append(links,(payload->>key)::uuid); END IF;\n"
3114 +     " END LOOP;\n"
3115 +     " RETURN links;\n"
3116 +     "END;\n"
3117 +     "$function$\n",
