1102 +     '"verification_preparations": "owner_id", '
1103 +     '"verification_run_identities": "owner_id", '
1104 +     '"verification_run_versions": "owner_id", '
1105 +     '"verification_window_proposals": "owner_id"}\'::jsonb;\n'
1106 +     "BEGIN\n"
1107 +     " IF TG_OP='DELETE' THEN value=to_jsonb(OLD); ELSE "
1108 +     "value=to_jsonb(NEW); END IF;\n"
1109 +     " IF TG_OP='UPDATE' AND\n"
1110 +     "   "
1111 +     "ROW(NEW.tenant_id,NEW.category_id,NEW.object_type,NEW.subject_id,NEW.owner_id)\n"
1112 +     "   IS DISTINCT FROM "
1113 +     "ROW(OLD.tenant_id,OLD.category_id,OLD.object_type,OLD.subject_id,OLD.owner_id)\n"
1114 +     " THEN RAISE EXCEPTION 'audience identity cannot be reassigned' "
1115 +     "USING ERRCODE='23514'; END IF;\n"
1116 +     " typ=value->>'object_type'; own_col=owners->>typ;\n"
1117 +     " t=(value->>'tenant_id')::uuid; c=(value->>'category_id')::uuid;\n"
1118 +     " sid=(value->>'subject_id')::uuid; "
1119 +     "expected_owner=(value->>'owner_id')::uuid;\n"
1120 +     " IF own_col IS NULL THEN\n"
1121 +     "  RAISE EXCEPTION 'audience target unavailable' USING "
1122 +     "ERRCODE='23514';\n"
1123 +     " END IF;\n"
1124 +     " IF typ='variant_revisions' THEN\n"
1125 +     "  IF "
1126 +     "m3_lock_variant_revision_audience_target(t,c,sid,expected_owner) "
1127 +     "IS DISTINCT FROM true THEN\n"
1128 +     "   RAISE EXCEPTION 'audience target unavailable' USING "
1129 +     "ERRCODE='23514';\n"
1130 +     "  END IF;\n"
1131 +     "  IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
1132 +     " END IF;\n"
1133 +     " IF typ='product_variants' THEN\n"
1134 +     "  IF m3_lock_variant_audience_target(t,c,sid,expected_owner) IS "
1135 +     "DISTINCT FROM true THEN\n"
1136 +     "   RAISE EXCEPTION 'audience target unavailable' USING "
1137 +     "ERRCODE='23514';\n"
1138 +     "  END IF;\n"
1139 +     "  IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
1140 +     " END IF;\n"
1141 +     " model_col=CASE WHEN typ='products' THEN 'id' WHEN "
1142 +     "typ='proposals' THEN 'baseline_product_id' ELSE 'product_id' "
1143 +     "END;\n"
1144 +     " EXECUTE format('SELECT %I,%I FROM public.%I WHERE tenant_id=$1 "
1145 +     "AND category_id=$2 AND id=$3',\n"
1146 +     "                own_col,model_col,typ) INTO actual_owner,model "
1147 +     "USING t,c,sid;\n"
1148 +     " IF actual_owner IS DISTINCT FROM expected_owner THEN\n"
1149 +     "  RAISE EXCEPTION 'audience target unavailable' USING "
1150 +     "ERRCODE='23514';\n"
1151 +     " END IF;\n"
1152 +     " IF model IS NOT NULL THEN\n"
1153 +     "  PERFORM 1 FROM products WHERE tenant_id=t AND category_id=c AND "
1154 +     "id=model FOR UPDATE;\n"
1155 +     "  IF NOT FOUND THEN\n"
1156 +     "   RAISE EXCEPTION 'audience model unavailable' USING "
1157 +     "ERRCODE='23514';\n"
1158 +     "  END IF;\n"
1159 +     " END IF;\n"
1160 +     " EXECUTE format('SELECT %I FROM public.%I\n"
1161 +     "  WHERE tenant_id=$1 AND category_id=$2 AND id=$3 FOR UPDATE',\n"
1162 +     "                own_col,typ) INTO actual_owner USING t,c,sid;\n"
1163 +     " IF actual_owner IS DISTINCT FROM expected_owner THEN\n"
1164 +     "  RAISE EXCEPTION 'audience target unavailable' USING "
1165 +     "ERRCODE='23514';\n"
1166 +     " END IF;\n"
1167 +     " IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
1168 +     "END $function$\n",
1169 + }
