2998 +     "   links=links || public.m3_lifecycle_typed_links(t,c,payload->'content'->key->'source');\n"
2999 +     "  END LOOP;\n"
3000 +     " ELSIF table_name='category_knowledge_entries' AND payload->>'kind'='voice' THEN\n"
