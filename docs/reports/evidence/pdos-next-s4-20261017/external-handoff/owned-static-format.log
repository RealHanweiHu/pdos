2395 +     "CREATE OR REPLACE FUNCTION public.m3_lifecycle_nodes(t uuid, c uuid, identities uuid[] DEFAULT "
2396 +     "NULL::uuid[])\n"
2397 +     " RETURNS TABLE(table_name text, node_id uuid, links uuid[])\n"
2398 +     " LANGUAGE plpgsql\n"
2399 +     " STABLE SECURITY DEFINER\n"
2400 +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
2401 +     "AS $function$\n"
2402 +     "DECLARE name text; payload jsonb; controls uuid[];\n"
2403 +     "BEGIN\n"
2404 +     " IF identities IS NULL THEN\n"
2405 +     "  SELECT coalesce(array_agg(id),'{}') INTO controls FROM public.action_receipts\n"
2406 +     "   WHERE tenant_id=t AND category_id=c AND operation LIKE 'evidence.lifecycle.%';\n"
2407 +     " ELSE controls='{}'; END IF;\n"
2408 +     " FOREACH name IN ARRAY CASE WHEN identities IS NULL THEN "
2409 +     "ARRAY['agent_runs','action_receipts','actual_configurations','artifact_versions','audit_entries','bom_lines','bom_revisions','build_authorization_decisions','build_current_authorizations','build_current_execution_assessments','build_execution_assessments','build_lots','build_operational_current','build_operational_facts','build_readiness','build_starts','builds','capa_current_observations','capa_current_verification_rules','capa_named_verification_reviews','capa_observation_facts','capa_remediation_links','capa_verification_evidence','capa_verification_rule_facts','change_approval_records','change_dependency_clocks','change_graph_captures','change_implementation_captures','change_implementation_records','change_order_records','change_request_currents','change_request_versions','claim_consumptions','claims','controlled_change_coverage_currents','controlled_change_coverage_facts','controlled_change_policy_currents','controlled_change_policy_facts','controlled_change_selection_currents','controlled_change_selection_facts','cost_current_inputs','cost_estimates','cost_input_snapshots','cost_source_captures','definition_revisions','definition_sources','definition_specs','engineering_configurations','manufacturing_baseline_document_links','manufacturing_preparation_currents','manufacturing_preparation_versions','measurement_import_captures','operational_material_holds','operational_resource_occupancies','original_scan_requests','original_scan_results','original_security','outbox_events','parts','plan_proposals','plan_revisions','process_revisions','product_variants','professional_authority_current','professional_authority_facts','project_product_links','project_tasks','project_work_packages','projects','quality_current_issues','quality_current_policies','quality_event_failure_links','quality_failure_maps','quality_issue_versions','quality_policy_facts','request_keys','runs','sample_allocations','sample_current_readiness','sample_readiness_facts','sample_run_usages','sample_units','sample_usage_sentinels','supply_current_snapshots','supply_kit_projections','supply_snapshots','supply_source_captures','task_dependencies','test_measurements','test_resource_current','test_resource_facts','test_resource_reservations','test_result_actions','test_result_projections','uploaded_originals','variant_revisions','verification_actual_method_applicabilities','verification_actual_method_batches','verification_current_actual_methods','verification_current_formal_requests','verification_current_preparations','verification_current_runs','verification_formal_requests','verification_handoff_facts','verification_launch_facts','verification_method_applicabilities','verification_preparations','verification_run_identities','verification_run_versions','verification_window_proposals','work_requests','proposals','proposal_items','proposal_item_versions','proposal_revisions','proposal_sources','proposal_submissions','proposal_decisions','project_open_items','category_knowledge_entries','category_knowledge_current','product_target_segments','parameter_versions','parameter_current','promotion_proofs','evidence_links','claim_withdrawals','manufacturing_baseline_publications','manufacturing_publication_currents','manufacturing_publication_documents','native_pilot_runs','native_pilot_currents','native_pilot_observations','release_packages','release_package_currents','release_decisions','release_policy_facts','release_policy_currents','external_handoff_authorizations','external_delivery_intents','external_receipts','external_handoff_currents'] "
2410 +     "ELSE ARRAY[\n"
2411 +     "  'artifact_versions','claims','definition_revisions','definition_sources','definition_specs',\n"
2412 +     "  'proposals','proposal_items','proposal_item_versions','proposal_submissions','proposal_decisions',\n"
2413 +     "  "
2414 +     "'category_knowledge_entries','category_knowledge_current','parameter_versions','parameter_current',\n"
2415 +     "  "
2416 +     "'evidence_links','promotion_proofs','native_pilot_runs','native_pilot_currents','native_pilot_observations','release_packages','release_package_currents','release_decisions','release_policy_facts','release_policy_currents','external_handoff_authorizations','external_delivery_intents','external_receipts','external_handoff_currents'] "
2417 +     "END LOOP\n"
2418 +     "  FOR payload IN EXECUTE CASE WHEN name=ANY(ARRAY['audit_entries','outbox_events','request_keys'])\n"
2419 +     "   THEN format('SELECT to_jsonb(x) FROM public.%I x JOIN public.action_receipts r ON "
2420 +     "r.id=x.receipt_id AND r.tenant_id=x.tenant_id WHERE x.tenant_id=$1 AND r.category_id=$2',name)\n"
2421 +     "   ELSE format('SELECT to_jsonb(x) FROM public.%I x WHERE tenant_id=$1 AND category_id=$2 AND ($3 IS "
2422 +     "NULL OR %I=ANY($3))',name,\n"
2423 +     "    CASE name WHEN 'category_knowledge_current' THEN 'lineage_id'\n"
2424 +     "     WHEN 'parameter_current' THEN 'parameter_id' ELSE 'id' END)\n"
2425 +     "   END USING t,c,identities LOOP\n"
2426 +     "   IF (payload->>'receipt_id')::uuid=ANY(controls) OR\n"
2427 +     "    (name='action_receipts' AND payload->>'operation' LIKE 'evidence.lifecycle.%') THEN CONTINUE; END "
2428 +     "IF;\n"
2429 +     "   table_name=name;\n"
2430 +     "   node_id=CASE name WHEN 'category_knowledge_current' THEN (payload->>'lineage_id')::uuid\n"
2431 +     "    WHEN 'parameter_current' THEN (payload->>'parameter_id')::uuid ELSE (payload->>'id')::uuid END;\n"
2432 +     "   IF identities IS NULL THEN links=public.m3_lifecycle_row_links(t,c,name,payload);\n"
2433 +     "   ELSE links=public.m3_lifecycle_source_links(t,c,name,payload); END IF;\n"
2434 +     "   -- Preserve predecessor's conservative legacy graph; M3-only nodes use\n"
2435 +     "   -- strictly typed/relational links. Root lookup never uses free-text UUIDs.\n"
2436 +     "   IF identities IS NULL AND "
2437 +     "name<>ALL(ARRAY['native_pilot_runs','native_pilot_currents','native_pilot_observations','release_packages','release_package_currents','release_decisions','release_policy_facts','release_policy_currents','external_handoff_authorizations','external_delivery_intents','external_receipts','external_handoff_currents','manufacturing_baseline_publications','manufacturing_publication_currents','manufacturing_publication_documents','proposals','proposal_items','proposal_item_versions','proposal_revisions','proposal_sources','proposal_submissions','proposal_decisions','project_open_items','category_knowledge_entries','category_knowledge_current','product_target_segments','parameter_versions','parameter_current','promotion_proofs','evidence_links','claim_withdrawals']) "
2438 +     "THEN\n"
2439 +     "    links=links || public.kernel_lifecycle_links(name,payload);\n"
2440 +     "   END IF;\n"
2441 +     "   RETURN NEXT;\n"
2442 +     "  END LOOP;\n"
2443 +     " END LOOP;\n"
2444 +     "END;\n"
2445 +     "$function$\n",
2446 +     "CREATE OR REPLACE FUNCTION public.m3_lifecycle_source_links(t uuid, c uuid, table_name text, payload "
2447 +     "jsonb)\n"
2448 +     " RETURNS uuid[]\n"
2449 +     " LANGUAGE plpgsql\n"
2450 +     " STABLE SECURITY DEFINER\n"
2451 +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
2452 +     "AS $function$\n"
2453 +     "DECLARE links uuid[]='{}'; extra uuid[]; key text; keys text[]; item jsonb; container jsonb;\n"
2454 +     " target_kind text; referenced_target uuid; referenced_version integer;\n"
2455 +     "BEGIN\n"
2456 +     " IF table_name='agent_runs' THEN RETURN public.kernel_lifecycle_links(table_name,payload); END IF;\n"
2457 +     " -- Only actual top-level relation columns establish raw UUID edges. Arbitrary\n"
2458 +     " -- content dictionaries are not relational rows, even if an extra key happens\n"
2459 +     " -- to be named source_id or item_id.\n"
2460 +     " keys=CASE table_name\n"
2461 +     "  WHEN 'artifact_versions' THEN ARRAY['original_id']\n"
2462 +     "  WHEN 'claims' THEN ARRAY['artifact_id','snapshot_id']\n"
2463 +     "  WHEN 'definition_revisions' THEN ARRAY['derived_from_definition_id','parent_definition_id',\n"
2464 +     "   'source_proposal_id','source_submission_id']\n"
2465 +     "  WHEN 'definition_sources' THEN ARRAY['artifact_id']\n"
2466 +     "  WHEN 'definition_specs' THEN ARRAY[]::text[]\n"
2467 +     "  WHEN 'proposals' THEN ARRAY['baseline_definition_id','current_submission_id']\n"
2468 +     "  WHEN 'proposal_items' THEN ARRAY[]::text[]\n"
2469 +     "  WHEN 'proposal_item_versions' THEN ARRAY[]::text[]\n"
2470 +     "  WHEN 'proposal_revisions' THEN ARRAY['proposal_id']\n"
2471 +     "  WHEN 'proposal_sources' THEN ARRAY['source_id']\n"
2472 +     "  WHEN 'proposal_submissions' THEN ARRAY[]::text[]\n"
2473 +     "  WHEN 'proposal_decisions' THEN ARRAY['submission_id']\n"
2474 +     "  WHEN 'project_open_items' THEN ARRAY['source_question_id','source_spec_item_id','g0_decision_id']\n"
2475 +     "  WHEN 'category_knowledge_current' THEN ARRAY['current_entry_id']\n"
2476 +     "  WHEN 'promotion_proofs' THEN ARRAY['knowledge_entry_id','source_proposal_id']\n"
2477 +     "  WHEN 'evidence_links' THEN ARRAY['evidence_id']\n"
2478 +     "  WHEN 'claim_withdrawals' THEN ARRAY['claim_id']\n"
2479 +     "  WHEN 'manufacturing_baseline_publications' THEN ARRAY['baseline_id','process_id','previous_id']\n"
2480 +     "  WHEN 'manufacturing_publication_currents' THEN ARRAY['version_id']\n"
2481 +     "  WHEN 'manufacturing_publication_documents' THEN ARRAY['document_id','process_id']\n"
2482 +     "  WHEN 'native_pilot_runs' THEN "
2483 +     "ARRAY['build_id','lot_id','actual_configuration_id','engineering_configuration_id','process_id','publication_id']\n"
2484 +     "  WHEN 'native_pilot_currents' THEN ARRAY['pilot_id','latest_observation_id']\n"
2485 +     "  WHEN 'native_pilot_observations' THEN ARRAY['pilot_id','previous_observation_id']\n"
2486 +     "  WHEN 'release_packages' THEN ARRAY['previous_id']\n"
2487 +     "  WHEN 'release_package_currents' THEN ARRAY['version_id']\n"
2488 +     "  WHEN 'release_decisions' THEN ARRAY['package_id']\n"
2489 +     "  WHEN 'release_policy_facts' THEN ARRAY['previous_id']\n"
2490 +     "  WHEN 'release_policy_currents' THEN ARRAY['fact_id']\n"
2491 +     "  WHEN 'external_handoff_authorizations' THEN "
2492 +     "ARRAY['package_id','engineering_decision_id','manufacturing_decision_id']\n"
2493 +     "  WHEN 'external_delivery_intents' THEN ARRAY['handoff_id']\n"
2494 +     "  WHEN 'external_receipts' THEN "
2495 +     "ARRAY['handoff_id','intent_id','previous_receipt_id','reconciles_id']\n"
2496 +     "  WHEN 'external_handoff_currents' THEN ARRAY['handoff_id','intent_id','latest_receipt_id']\n"
2497 +     "  ELSE ARRAY[]::text[] END;\n"
2498 +     " FOREACH key IN ARRAY keys LOOP\n"
2499 +     "  IF payload->>key IS NOT NULL THEN links=array_append(links,(payload->>key)::uuid); END IF;\n"
2500 +     " END LOOP;\n"
2501 +     " -- Publication's exact saved read set is a validated Artifact relationship.\n"
2502 +     " -- Do not scan its declaration, body, reason or arbitrary JSON UUID values.\n"
2503 +     " IF table_name IN "
2504 +     "('manufacturing_baseline_publications','native_pilot_runs','native_pilot_observations','release_packages','release_decisions','release_policy_facts','external_handoff_authorizations','external_receipts') "
2505 +     "THEN\n"
2506 +     "  FOR item IN SELECT value FROM "
2507 +     "jsonb_array_elements(coalesce(payload->'required_source_read_set','[]')) LOOP\n"
2508 +     "   IF item->>'artifact_id' IS NOT NULL THEN\n"
2509 +     "    links=array_append(links,(item->>'artifact_id')::uuid);\n"
2510 +     "   END IF;\n"
2511 +     "  END LOOP;\n"
2512 +     " END IF;\n"
2513 +     " IF table_name IN ('native_pilot_runs','native_pilot_observations') THEN\n"
2514 +     "  FOR item IN SELECT value FROM "
2515 +     "jsonb_array_elements(coalesce(payload#>'{material_snapshot,statistics,samples}','[]')) LOOP\n"
2516 +     "   IF item->>'id' IS NOT NULL THEN links=array_append(links,(item->>'id')::uuid); END IF;\n"
2517 +     "  END LOOP;\n"
2518 +     "  FOR item IN SELECT value FROM "
2519 +     "jsonb_array_elements(coalesce(payload#>'{material_snapshot,statistics,issues}','[]')) LOOP\n"
2520 +     "   IF item->>'id' IS NOT NULL THEN links=array_append(links,(item->>'id')::uuid); END IF;\n"
2521 +     "  END LOOP;\n"
2522 +     "  item=payload#>'{material_snapshot,statistics,resource,fact}';\n"
2523 +     "  IF item->>'id' IS NOT NULL THEN links=array_append(links,(item->>'id')::uuid); END IF;\n"
2524 +     " END IF;\n"
2525 +     " IF table_name='release_packages' THEN\n"
2526 +     "  -- FixedObject.ref is a closed, server-resolved version reference, not arbitrary body UUID text.\n"
2527 +     "  FOR item IN SELECT value FROM jsonb_array_elements(coalesce(payload#>'{body,objects}','[]')) LOOP\n"
2528 +     "   container=item->'ref';\n"
2529 +     "   IF "
2530 +     "container->>'kind'=ANY(ARRAY['definition','engineering_configuration','process_revision','manufacturing_publication','test_run','pilot_run','issue','change','exception','artifact','work_instruction','control_plan','build_lot','line'])\n"
2531 +     "    AND container->>'id' IS NOT NULL THEN links=array_append(links,(container->>'id')::uuid); END "
2532 +     "IF;\n"
2533 +     "  END LOOP;\n"
2534 +     " END IF;\n"
2535 +     " IF table_name IN ('external_handoff_authorizations','external_delivery_intents') THEN\n"
2536 +     "  -- Only closed, owner-verified mapping and manifest references are source edges.\n"
2537 +     "  container=CASE WHEN table_name='external_handoff_authorizations' THEN payload#>'{body,declaration}' "
2538 +     "ELSE payload->'body' END;\n"
2539 +     "  FOR item IN SELECT value FROM jsonb_array_elements(coalesce(container->'mappings','[]')) LOOP\n"
2540 +     "   IF "
2541 +     "item->'ref'->>'kind'=ANY(ARRAY['definition','engineering_configuration','process_revision','part','bom_revision','artifact','work_instruction','control_plan'])\n"
2542 +     "    AND item->'ref'->>'id' IS NOT NULL THEN links=array_append(links,(item->'ref'->>'id')::uuid); END "
2543 +     "IF;\n"
2544 +     "  END LOOP;\n"
2545 +     "  FOR item IN SELECT value FROM jsonb_array_elements(coalesce(container->'manifest','[]')) LOOP\n"
2546 +     "   IF item->'artifact'->>'id' IS NOT NULL THEN "
2547 +     "links=array_append(links,(item->'artifact'->>'id')::uuid); END IF;\n"
2548 +     "  END LOOP;\n"
2549 +     " END IF;\n"
2550 +     " IF table_name='release_policy_facts' THEN\n"
2551 +     "  -- These are Closed DTO configuration references fixed by the policy owner.\n"
2552 +     "  FOREACH key IN ARRAY ARRAY['definition','engineering_configuration','manufacturing_configuration'] "
2553 +     "LOOP\n"
2554 +     "   container=payload#>ARRAY['material','subject_config',key];\n"
2555 +     "   IF container->>'id' IS NOT NULL THEN links=array_append(links,(container->>'id')::uuid); END IF;\n"
2556 +     "  END LOOP;\n"
2557 +     " END IF;\n"
2558 +     " -- These stored fields are validated Reference containers. Do not feed the\n"
2559 +     " -- whole row or arbitrary content into the canonical Reference parser.\n"
2560 +     " IF table_name=ANY(ARRAY['proposals','proposal_item_versions','proposal_submissions',\n"
2561 +     "  'category_knowledge_entries','definition_specs']) THEN\n"
2562 +     "  FOREACH key IN ARRAY ARRAY['source_refs','direct_source_refs','context_refs','baseline_claim_refs'] "
2563 +     "LOOP\n"
2564 +     "   links=links || public.m3_lifecycle_typed_links(t,c,payload->key);\n"
2565 +     "  END LOOP;\n"
2566 +     " END IF;\n"
2567 +     " -- Match ItemInput.content_schema and category_service._references: only\n"
2568 +     " -- commercial_target, voice, and competitor have nested source contracts.\n"
2569 +     " IF table_name='proposal_item_versions' AND payload->>'kind'='commercial_target' THEN\n"
2570 +     "  FOREACH key IN ARRAY ARRAY['target_price','cost','volume'] LOOP\n"
2571 +     "   links=links || public.m3_lifecycle_typed_links(t,c,payload->'content'->key->'source');\n"
2572 +     "  END LOOP;\n"
2573 +     " ELSIF table_name='category_knowledge_entries' AND payload->>'kind'='voice' THEN\n"
2574 +     "  links=links || public.m3_lifecycle_typed_links(t,c,payload->'content'->'representative_refs');\n"
2575 +     " ELSIF table_name='category_knowledge_entries' AND payload->>'kind'='competitor' THEN\n"
2576 +     "  FOREACH key IN ARRAY ARRAY['metrics','features','prices'] LOOP\n"
2577 +     "   FOR item IN SELECT value FROM jsonb_array_elements(coalesce(payload->'content'->key,'[]')) LOOP\n"
2578 +     "    links=links || public.m3_lifecycle_typed_links(t,c,item->'source_ref');\n"
2579 +     "   END LOOP;\n"
2580 +     "  END LOOP;\n"
2581 +     " END IF;\n"
2582 +     " IF table_name='proposal_submissions' THEN\n"
2583 +     "  container=payload->'frozen_document';\n"
2584 +     "  FOREACH key IN ARRAY ARRAY['source_refs','direct_source_refs','context_refs','baseline_claim_refs'] "
2585 +     "LOOP\n"
2586 +     "   links=links || public.m3_lifecycle_typed_links(t,c,container->key);\n"
2587 +     "  END LOOP;\n"
2588 +     "  FOR item IN SELECT value FROM jsonb_array_elements(coalesce(container->'items','[]')) LOOP\n"
2589 +     "   links=links || "
2590 +     "public.m3_lifecycle_source_links(t,c,'proposal_item_versions',item-ARRAY['item_id','proposal_id']);\n"
2591 +     "   -- The frozen read projection records actual EvidenceLink provenance here.\n"
2592 +     "   links=links || public.m3_lifecycle_typed_links(t,c,item->'evidence_links');\n"
2593 +     "  END LOOP;\n"
2594 +     " ELSIF table_name='promotion_proofs' THEN\n"
2595 +     "  FOR item IN SELECT value FROM jsonb_array_elements(coalesce(payload->'source_item_refs','[]')) "
2596 +     "LOOP\n"
2597 +     "   IF item->>'item_id' IS NOT NULL THEN links=array_append(links,(item->>'item_id')::uuid); END IF;\n"
2598 +     "  END LOOP;\n"
2599 +     " END IF;\n"
2600 +     " -- Exact persisted EvidenceLink targets supplement these immutable versions.\n"
2601 +     " -- Reverted links and withdrawn Claims still retain the original historical\n"
2602 +     " -- dependency; lifecycle cleanup must not erase their audit source.\n"
2603 +     " IF table_name='proposal_item_versions' AND payload->>'item_id' IS NOT NULL THEN\n"
2604 +     "  target_kind='proposal_item'; referenced_target=(payload->>'item_id')::uuid;\n"
2605 +     "  referenced_version=(payload->>'version')::integer;\n"
2606 +     " ELSIF table_name='category_knowledge_entries' AND payload->>'id' IS NOT NULL THEN\n"
2607 +     "  target_kind='knowledge_entry'; referenced_target=(payload->>'id')::uuid;\n"
2608 +     "  referenced_version=(payload->>'version')::integer;\n"
2609 +     " ELSIF table_name='definition_specs' AND payload->>'id' IS NOT NULL THEN\n"
2610 +     "  target_kind='definition_spec'; referenced_target=(payload->>'id')::uuid;\n"
2611 +     "  SELECT revision INTO referenced_version FROM public.definition_revisions\n"
2612 +     "   WHERE tenant_id=t AND category_id=c AND id=(payload->>'definition_id')::uuid;\n"
2613 +     " END IF;\n"
2614 +     " IF referenced_target IS NOT NULL AND referenced_version IS NOT NULL THEN\n"
2615 +     "  SELECT coalesce(array_agg(link.evidence_id),'{}') INTO extra FROM public.evidence_links link\n"
2616 +     "   WHERE link.tenant_id=t AND link.category_id=c AND link.target_type=target_kind\n"
2617 +     "    AND link.target_id=referenced_target AND link.target_version=referenced_version;\n"
2618 +     "  links=links || extra;\n"
2619 +     " END IF;\n"
2620 +     " -- Child source rows point to their parent, whereas dependency traversal needs\n"
2621 +     " -- the parent's fixed source children as well. Keep the actual relational edge.\n"
2622 +     " IF table_name='definition_revisions' THEN\n"
2623 +     "  SELECT coalesce(array_agg(id),'{}') INTO extra FROM (\n"
2624 +     "   SELECT id FROM public.definition_sources WHERE tenant_id=t AND category_id=c\n"
2625 +     "    AND definition_id=(payload->>'id')::uuid\n"
2626 +     "   UNION ALL SELECT id FROM public.definition_specs WHERE tenant_id=t AND category_id=c\n"
2627 +     "    AND definition_id=(payload->>'id')::uuid\n"
2628 +     "  ) children;\n"
2629 +     "  links=links || extra;\n"
2630 +     " ELSIF table_name='proposals' THEN\n"
2631 +     "  SELECT coalesce(array_agg(id),'{}') INTO extra FROM public.proposal_item_versions\n"
2632 +     "   WHERE tenant_id=t AND category_id=c AND proposal_id=(payload->>'id')::uuid;\n"
2633 +     "  links=links || extra;\n"
2634 +     " ELSIF table_name='proposal_items' THEN\n"
2635 +     "  SELECT coalesce(array_agg(id),'{}') INTO extra FROM public.proposal_item_versions\n"
2636 +     "   WHERE tenant_id=t AND category_id=c AND item_id=(payload->>'id')::uuid;\n"
2637 +     "  links=links || extra;\n"
2638 +     " ELSIF table_name='product_target_segments' THEN\n"
2639 +     "  SELECT coalesce(array_agg(id),'{}') INTO extra FROM public.category_knowledge_entries\n"
2640 +     "   WHERE tenant_id=t AND category_id=c AND lineage_id=(payload->>'segment_lineage_id')::uuid\n"
2641 +     "    AND version=(payload->>'segment_version')::integer;\n"
2642 +     "  links=links || extra;\n"
2643 +     " ELSIF table_name='parameter_current' THEN\n"
2644 +     "  SELECT coalesce(array_agg(id),'{}') INTO extra FROM public.parameter_versions\n"
2645 +     "   WHERE tenant_id=t AND category_id=c AND parameter_id=(payload->>'parameter_id')::uuid\n"
2646 +     "    AND version=(payload->>'current_version')::integer;\n"
2647 +     "  links=links || extra;\n"
2648 +     " END IF;\n"
2649 +     " RETURN links;\n"
2650 +     "END;\n"
2651 +     "$function$\n",
2652 +     "CREATE OR REPLACE FUNCTION public.m3_lifecycle_row_links(t uuid, c uuid, table_name text, payload "
2653 +     "jsonb)\n"
2654 +     " RETURNS uuid[]\n"
2655 +     " LANGUAGE plpgsql\n"
2656 +     " STABLE SECURITY DEFINER\n"
2657 +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
2658 +     "AS $function$\n"
2659 +     "DECLARE links uuid[]; key text; keys text[];\n"
2660 +     "BEGIN\n"
2661 +     " links=public.m3_lifecycle_source_links(t,c,table_name,payload);\n"
2662 +     " -- Only the infrequent retention summary needs host/reverse relationships.\n"
2663 +     " -- They must not turn a source-free item INSERT into a proposal-history scan.\n"
2664 +     " keys=CASE table_name\n"
2665 +     "  WHEN 'definition_sources' THEN ARRAY['definition_id']\n"
2666 +     "  WHEN 'definition_specs' THEN ARRAY['definition_id']\n"
2667 +     "  WHEN 'proposal_items' THEN ARRAY['proposal_id']\n"
2668 +     "  WHEN 'proposal_item_versions' THEN ARRAY['proposal_id','item_id']\n"
2669 +     "  WHEN 'proposal_sources' THEN ARRAY['proposal_id']\n"
2670 +     "  WHEN 'proposal_submissions' THEN ARRAY['proposal_id']\n"
2671 +     "  WHEN 'proposal_decisions' THEN ARRAY['proposal_id','created_definition_id']\n"
2672 +     "  WHEN 'evidence_links' THEN ARRAY['target_id']\n"
2673 +     "  WHEN 'manufacturing_baseline_publications' THEN ARRAY['project_id']\n"
2674 +     "  WHEN 'manufacturing_publication_currents' THEN ARRAY['series_id']\n"
2675 +     "  WHEN 'manufacturing_publication_documents' THEN ARRAY['publication_id']\n"
2676 +     "  WHEN 'native_pilot_runs' THEN ARRAY['project_id']\n"
2677 +     "  WHEN 'native_pilot_currents' THEN ARRAY['pilot_id']\n"
2678 +     "  WHEN 'native_pilot_observations' THEN ARRAY['pilot_id']\n"
2679 +     "  WHEN 'release_packages' THEN ARRAY['project_id','series_id']\n"
2680 +     "  WHEN 'release_package_currents' THEN ARRAY['series_id']\n"
2681 +     "  WHEN 'release_decisions' THEN ARRAY['package_id']\n"
2682 +     "  WHEN 'release_policy_facts' THEN ARRAY['project_id','series_id']\n"
2683 +     "  WHEN 'release_policy_currents' THEN ARRAY['series_id']\n"
2684 +     "  WHEN 'external_handoff_authorizations' THEN ARRAY['project_id']\n"
2685 +     "  WHEN 'external_delivery_intents' THEN ARRAY['project_id']\n"
2686 +     "  WHEN 'external_receipts' THEN ARRAY['project_id']\n"
2687 +     "  WHEN 'external_handoff_currents' THEN ARRAY['project_id']\n"
2688 +     "  ELSE ARRAY[]::text[] END;\n"
2689 +     " FOREACH key IN ARRAY keys LOOP\n"
2690 +     "  IF payload->>key IS NOT NULL THEN links=array_append(links,(payload->>key)::uuid); END IF;\n"
2691 +     " END LOOP;\n"
2692 +     " RETURN links;\n"
2693 +     "END;\n"
2694 +     "$function$\n",
2695 +     "CREATE OR REPLACE FUNCTION public.protect_object_audience_target()\n"
2696 +     " RETURNS trigger\n"
2697 +     " LANGUAGE plpgsql\n"
2698 +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
2699 +     "AS $function$\n"
2700 +     "DECLARE value jsonb; typ text; own_col text; model_col text;\n"
2701 +     " t uuid; c uuid; sid uuid; expected_owner uuid; actual_owner uuid; model uuid;\n"
2702 +     ' owners jsonb=\'{"action_receipts": "requester_id", "actual_configurations": "owner_id", '
2703 +     '"artifact_versions": "owner_id", "bom_revisions": "owner_id", "build_authorization_decisions": '
2704 +     '"owner_id", "build_execution_assessments": "owner_id", "build_lots": "owner_id", '
2705 +     '"build_operational_facts": "owner_id", "build_readiness": "owner_id", "build_starts": "owner_id", '
2706 +     '"builds": "owner_id", "capa_current_observations": "owner_id", "capa_current_verification_rules": '
2707 +     '"owner_id", "capa_named_verification_reviews": "owner_id", "capa_observation_facts": "owner_id", '
2708 +     '"capa_remediation_links": "owner_id", "capa_verification_evidence": "owner_id", '
2709 +     '"capa_verification_rule_facts": "owner_id", "change_approval_records": "owner_id", '
2710 +     '"change_graph_captures": "owner_id", "change_implementation_captures": "owner_id", '
2711 +     '"change_implementation_records": "owner_id", "change_order_records": "owner_id", '
2712 +     '"change_request_versions": "owner_id", "claims": "human_owner_id", '
2713 +     '"controlled_change_coverage_currents": "owner_id", "controlled_change_coverage_facts": "owner_id", '
2714 +     '"controlled_change_policy_currents": "owner_id", "controlled_change_policy_facts": "owner_id", '
2715 +     '"controlled_change_selection_currents": "owner_id", "controlled_change_selection_facts": "owner_id", '
2716 +     '"cost_estimates": "owner_id", "cost_input_snapshots": "owner_id", "cost_source_captures": "owner_id", '
2717 +     '"definition_revisions": "owner_id", "engineering_configurations": "owner_id", '
2718 +     '"external_delivery_intents": "owner_id", "external_handoff_authorizations": "owner_id", '
2719 +     '"external_handoff_currents": "owner_id", "external_receipts": "owner_id", '
2720 +     '"manufacturing_preparation_currents": "owner_id", "manufacturing_preparation_versions": "owner_id", '
2721 +     '"measurement_import_captures": "owner_id", "parts": "owner_id", "plan_proposals": "owner_id", '
2722 +     '"plan_revisions": "owner_id", "process_revisions": "owner_id", "product_variants": "owner_id", '
2723 +     '"products": "owner_id", "professional_authority_facts": "owner_id", "projects": "owner_id", '
2724 +     '"proposals": "owner_id", "quality_issue_versions": "owner_id", "quality_policy_facts": "owner_id", '
2725 +     '"sample_allocations": "owner_id", "sample_readiness_facts": "owner_id", "sample_run_usages": '
2726 +     '"owner_id", "sample_units": "owner_id", "supply_kit_projections": "owner_id", "supply_snapshots": '
2727 +     '"owner_id", "supply_source_captures": "owner_id", "test_measurements": "owner_id", '
2728 +     '"test_resource_facts": "owner_id", "test_resource_reservations": "owner_id", "test_result_actions": '
2729 +     '"owner_id", "test_result_projections": "owner_id", "uploaded_originals": "owner_id", '
2730 +     '"variant_revisions": "owner_id", "verification_actual_method_applicabilities": "owner_id", '
2731 +     '"verification_actual_method_batches": "owner_id", "verification_formal_requests": "owner_id", '
2732 +     '"verification_handoff_facts": "owner_id", "verification_launch_facts": "owner_id", '
2733 +     '"verification_method_applicabilities": "owner_id", "verification_preparations": "owner_id", '
2734 +     '"verification_run_identities": "owner_id", "verification_run_versions": "owner_id", '
2735 +     '"verification_window_proposals": "owner_id"}\'::jsonb;\n'
2736 +     "BEGIN\n"
2737 +     " IF TG_OP='DELETE' THEN value=to_jsonb(OLD); ELSE value=to_jsonb(NEW); END IF;\n"
2738 +     " IF TG_OP='UPDATE' AND\n"
2739 +     "   ROW(NEW.tenant_id,NEW.category_id,NEW.object_type,NEW.subject_id,NEW.owner_id)\n"
2740 +     "   IS DISTINCT FROM ROW(OLD.tenant_id,OLD.category_id,OLD.object_type,OLD.subject_id,OLD.owner_id)\n"
2741 +     " THEN RAISE EXCEPTION 'audience identity cannot be reassigned' USING ERRCODE='23514'; END IF;\n"
2742 +     " typ=value->>'object_type'; own_col=owners->>typ;\n"
