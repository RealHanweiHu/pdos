2903 +     "BEGIN\n"
2904 +     " IF table_name='agent_runs' THEN RETURN public.kernel_lifecycle_links(table_name,payload); END IF;\n"
2905 +     " -- Only actual top-level relation columns establish raw UUID edges. Arbitrary\n"
2906 +     " -- content dictionaries are not relational rows, even if an extra key happens\n"
2907 +     " -- to be named source_id or item_id.\n"
2908 +     " keys=CASE table_name\n"
