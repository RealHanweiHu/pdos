565  + HANDOFF_FUNCTIONS = {
566  +     "m3_lifecycle_nodes(uuid,uuid,uuid[])": "CREATE OR REPLACE FUNCTION public.m3_lifecycle_nodes(t uuid, "
567  +     "c uuid, identities uuid[] DEFAULT NULL::uuid[])\n"
568  +     " RETURNS TABLE(table_name text, node_id uuid, links uuid[])\n"
569  +     " LANGUAGE plpgsql\n"
570  +     " STABLE SECURITY DEFINER\n"
571  +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
572  +     "AS $function$\n"
573  +     "DECLARE name text; payload jsonb; controls uuid[];\n"
574  +     "BEGIN\n"
575  +     " IF identities IS NULL THEN\n"
576  +     "  SELECT coalesce(array_agg(id),'{}') INTO controls FROM "
577  +     "public.action_receipts\n"
578  +     "   WHERE tenant_id=t AND category_id=c AND operation LIKE "
579  +     "'evidence.lifecycle.%';\n"
580  +     " ELSE controls='{}'; END IF;\n"
581  +     " FOREACH name IN ARRAY CASE WHEN identities IS NULL THEN "
582  +     "ARRAY['agent_runs','action_receipts','actual_configurations','artifact_versions','audit_entries','bom_lines','bom_revisions','build_authorization_decisions','build_current_authorizations','build_current_execution_assessments','build_execution_assessments','build_lots','build_operational_current','build_operational_facts','build_readiness','build_starts','builds','capa_current_observations','capa_current_verification_rules','capa_named_verification_reviews','capa_observation_facts','capa_remediation_links','capa_verification_evidence','capa_verification_rule_facts','change_approval_records','change_dependency_clocks','change_graph_captures','change_implementation_captures','change_implementation_records','change_order_records','change_request_currents','change_request_versions','claim_consumptions','claims','controlled_change_coverage_currents','controlled_change_coverage_facts','controlled_change_policy_currents','controlled_change_policy_facts','controlled_change_selection_currents','controlled_change_selection_facts','cost_current_inputs','cost_estimates','cost_input_snapshots','cost_source_captures','definition_revisions','definition_sources','definition_specs','engineering_configurations','manufacturing_baseline_document_links','manufacturing_preparation_currents','manufacturing_preparation_versions','measurement_import_captures','operational_material_holds','operational_resource_occupancies','original_scan_requests','original_scan_results','original_security','outbox_events','parts','plan_proposals','plan_revisions','process_revisions','product_variants','professional_authority_current','professional_authority_facts','project_product_links','project_tasks','project_work_packages','projects','quality_current_issues','quality_current_policies','quality_event_failure_links','quality_failure_maps','quality_issue_versions','quality_policy_facts','request_keys','runs','sample_allocations','sample_current_readiness','sample_readiness_facts','sample_run_usages','sample_units','sample_usage_sentinels','supply_current_snapshots','supply_kit_projections','supply_snapshots','supply_source_captures','task_dependencies','test_measurements','test_resource_current','test_resource_facts','test_resource_reservations','test_result_actions','test_result_projections','uploaded_originals','variant_revisions','verification_actual_method_applicabilities','verification_actual_method_batches','verification_current_actual_methods','verification_current_formal_requests','verification_current_preparations','verification_current_runs','verification_formal_requests','verification_handoff_facts','verification_launch_facts','verification_method_applicabilities','verification_preparations','verification_run_identities','verification_run_versions','verification_window_proposals','work_requests','proposals','proposal_items','proposal_item_versions','proposal_revisions','proposal_sources','proposal_submissions','proposal_decisions','project_open_items','category_knowledge_entries','category_knowledge_current','product_target_segments','parameter_versions','parameter_current','promotion_proofs','evidence_links','claim_withdrawals','manufacturing_baseline_publications','manufacturing_publication_currents','manufacturing_publication_documents','native_pilot_runs','native_pilot_currents','native_pilot_observations','release_packages','release_package_currents','release_decisions','release_policy_facts','release_policy_currents','external_handoff_authorizations','external_delivery_intents','external_receipts','external_handoff_currents'] "
583  +     "ELSE ARRAY[\n"
584  +     "  "
585  +     "'artifact_versions','claims','definition_revisions','definition_sources','definition_specs',\n"
586  +     "  "
587  +     "'proposals','proposal_items','proposal_item_versions','proposal_submissions','proposal_decisions',\n"
588  +     "  "
589  +     "'category_knowledge_entries','category_knowledge_current','parameter_versions','parameter_current',\n"
590  +     "  "
591  +     "'evidence_links','promotion_proofs','native_pilot_runs','native_pilot_currents','native_pilot_observations','release_packages','release_package_currents','release_decisions','release_policy_facts','release_policy_currents','external_handoff_authorizations','external_delivery_intents','external_receipts','external_handoff_currents'] "
592  +     "END LOOP\n"
593  +     "  FOR payload IN EXECUTE CASE WHEN "
594  +     "name=ANY(ARRAY['audit_entries','outbox_events','request_keys'])\n"
595  +     "   THEN format('SELECT to_jsonb(x) FROM public.%I x JOIN "
596  +     "public.action_receipts r ON r.id=x.receipt_id AND "
597  +     "r.tenant_id=x.tenant_id WHERE x.tenant_id=$1 AND "
598  +     "r.category_id=$2',name)\n"
599  +     "   ELSE format('SELECT to_jsonb(x) FROM public.%I x WHERE "
600  +     "tenant_id=$1 AND category_id=$2 AND ($3 IS NULL OR "
601  +     "%I=ANY($3))',name,\n"
602  +     "    CASE name WHEN 'category_knowledge_current' THEN "
603  +     "'lineage_id'\n"
604  +     "     WHEN 'parameter_current' THEN 'parameter_id' ELSE 'id' "
605  +     "END)\n"
606  +     "   END USING t,c,identities LOOP\n"
607  +     "   IF (payload->>'receipt_id')::uuid=ANY(controls) OR\n"
608  +     "    (name='action_receipts' AND payload->>'operation' LIKE "
609  +     "'evidence.lifecycle.%') THEN CONTINUE; END IF;\n"
610  +     "   table_name=name;\n"
611  +     "   node_id=CASE name WHEN 'category_knowledge_current' THEN "
612  +     "(payload->>'lineage_id')::uuid\n"
613  +     "    WHEN 'parameter_current' THEN "
614  +     "(payload->>'parameter_id')::uuid ELSE (payload->>'id')::uuid "
615  +     "END;\n"
616  +     "   IF identities IS NULL THEN "
617  +     "links=public.m3_lifecycle_row_links(t,c,name,payload);\n"
618  +     "   ELSE "
619  +     "links=public.m3_lifecycle_source_links(t,c,name,payload); END "
620  +     "IF;\n"
621  +     "   -- Preserve predecessor's conservative legacy graph; "
622  +     "M3-only nodes use\n"
623  +     "   -- strictly typed/relational links. Root lookup never uses "
624  +     "free-text UUIDs.\n"
625  +     "   IF identities IS NULL AND "
626  +     "name<>ALL(ARRAY['native_pilot_runs','native_pilot_currents','native_pilot_observations','release_packages','release_package_currents','release_decisions','release_policy_facts','release_policy_currents','external_handoff_authorizations','external_delivery_intents','external_receipts','external_handoff_currents','manufacturing_baseline_publications','manufacturing_publication_currents','manufacturing_publication_documents','proposals','proposal_items','proposal_item_versions','proposal_revisions','proposal_sources','proposal_submissions','proposal_decisions','project_open_items','category_knowledge_entries','category_knowledge_current','product_target_segments','parameter_versions','parameter_current','promotion_proofs','evidence_links','claim_withdrawals']) "
627  +     "THEN\n"
628  +     "    links=links || "
629  +     "public.kernel_lifecycle_links(name,payload);\n"
630  +     "   END IF;\n"
631  +     "   RETURN NEXT;\n"
632  +     "  END LOOP;\n"
633  +     " END LOOP;\n"
634  +     "END;\n"
635  +     "$function$\n",
636  +     "m3_lifecycle_source_links(uuid,uuid,text,jsonb)": "CREATE OR REPLACE FUNCTION "
637  +     "public.m3_lifecycle_source_links(t uuid, c uuid, "
638  +     "table_name text, payload jsonb)\n"
639  +     " RETURNS uuid[]\n"
640  +     " LANGUAGE plpgsql\n"
641  +     " STABLE SECURITY DEFINER\n"
642  +     " SET search_path TO 'pg_catalog', 'public', "
643  +     "'pg_temp'\n"
644  +     "AS $function$\n"
645  +     "DECLARE links uuid[]='{}'; extra uuid[]; key text; "
646  +     "keys text[]; item jsonb; container jsonb;\n"
647  +     " target_kind text; referenced_target uuid; "
648  +     "referenced_version integer;\n"
649  +     "BEGIN\n"
650  +     " IF table_name='agent_runs' THEN RETURN "
651  +     "public.kernel_lifecycle_links(table_name,payload); "
652  +     "END IF;\n"
653  +     " -- Only actual top-level relation columns "
654  +     "establish raw UUID edges. Arbitrary\n"
655  +     " -- content dictionaries are not relational rows, "
656  +     "even if an extra key happens\n"
657  +     " -- to be named source_id or item_id.\n"
658  +     " keys=CASE table_name\n"
659  +     "  WHEN 'artifact_versions' THEN "
660  +     "ARRAY['original_id']\n"
661  +     "  WHEN 'claims' THEN "
662  +     "ARRAY['artifact_id','snapshot_id']\n"
663  +     "  WHEN 'definition_revisions' THEN "
664  +     "ARRAY['derived_from_definition_id','parent_definition_id',\n"
665  +     "   'source_proposal_id','source_submission_id']\n"
666  +     "  WHEN 'definition_sources' THEN "
667  +     "ARRAY['artifact_id']\n"
668  +     "  WHEN 'definition_specs' THEN ARRAY[]::text[]\n"
669  +     "  WHEN 'proposals' THEN "
670  +     "ARRAY['baseline_definition_id','current_submission_id']\n"
671  +     "  WHEN 'proposal_items' THEN ARRAY[]::text[]\n"
672  +     "  WHEN 'proposal_item_versions' THEN "
673  +     "ARRAY[]::text[]\n"
674  +     "  WHEN 'proposal_revisions' THEN "
675  +     "ARRAY['proposal_id']\n"
676  +     "  WHEN 'proposal_sources' THEN ARRAY['source_id']\n"
677  +     "  WHEN 'proposal_submissions' THEN "
678  +     "ARRAY[]::text[]\n"
679  +     "  WHEN 'proposal_decisions' THEN "
680  +     "ARRAY['submission_id']\n"
681  +     "  WHEN 'project_open_items' THEN "
682  +     "ARRAY['source_question_id','source_spec_item_id','g0_decision_id']\n"
683  +     "  WHEN 'category_knowledge_current' THEN "
684  +     "ARRAY['current_entry_id']\n"
685  +     "  WHEN 'promotion_proofs' THEN "
686  +     "ARRAY['knowledge_entry_id','source_proposal_id']\n"
687  +     "  WHEN 'evidence_links' THEN ARRAY['evidence_id']\n"
688  +     "  WHEN 'claim_withdrawals' THEN ARRAY['claim_id']\n"
689  +     "  WHEN 'manufacturing_baseline_publications' THEN "
690  +     "ARRAY['baseline_id','process_id','previous_id']\n"
691  +     "  WHEN 'manufacturing_publication_currents' THEN "
692  +     "ARRAY['version_id']\n"
693  +     "  WHEN 'manufacturing_publication_documents' THEN "
694  +     "ARRAY['document_id','process_id']\n"
695  +     "  WHEN 'native_pilot_runs' THEN "
696  +     "ARRAY['build_id','lot_id','actual_configuration_id','engineering_configuration_id','process_id','publication_id']\n"
697  +     "  WHEN 'native_pilot_currents' THEN "
698  +     "ARRAY['pilot_id','latest_observation_id']\n"
699  +     "  WHEN 'native_pilot_observations' THEN "
700  +     "ARRAY['pilot_id','previous_observation_id']\n"
701  +     "  WHEN 'release_packages' THEN "
702  +     "ARRAY['previous_id']\n"
703  +     "  WHEN 'release_package_currents' THEN "
704  +     "ARRAY['version_id']\n"
705  +     "  WHEN 'release_decisions' THEN "
706  +     "ARRAY['package_id']\n"
707  +     "  WHEN 'release_policy_facts' THEN "
708  +     "ARRAY['previous_id']\n"
709  +     "  WHEN 'release_policy_currents' THEN "
710  +     "ARRAY['fact_id']\n"
711  +     "  WHEN 'external_handoff_authorizations' THEN "
712  +     "ARRAY['package_id','engineering_decision_id','manufacturing_decision_id']\n"
713  +     "  WHEN 'external_delivery_intents' THEN "
714  +     "ARRAY['handoff_id']\n"
715  +     "  WHEN 'external_receipts' THEN "
716  +     "ARRAY['handoff_id','intent_id','previous_receipt_id','reconciles_id']\n"
717  +     "  WHEN 'external_handoff_currents' THEN "
718  +     "ARRAY['handoff_id','intent_id','latest_receipt_id']\n"
719  +     "  ELSE ARRAY[]::text[] END;\n"
720  +     " FOREACH key IN ARRAY keys LOOP\n"
721  +     "  IF payload->>key IS NOT NULL THEN "
722  +     "links=array_append(links,(payload->>key)::uuid); "
723  +     "END IF;\n"
724  +     " END LOOP;\n"
725  +     " -- Publication's exact saved read set is a "
726  +     "validated Artifact relationship.\n"
727  +     " -- Do not scan its declaration, body, reason or "
728  +     "arbitrary JSON UUID values.\n"
729  +     " IF table_name IN "
730  +     "('manufacturing_baseline_publications','native_pilot_runs','native_pilot_observations','release_packages','release_decisions','release_policy_facts','external_handoff_authorizations','external_receipts') "
731  +     "THEN\n"
732  +     "  FOR item IN SELECT value FROM "
733  +     "jsonb_array_elements(coalesce(payload->'required_source_read_set','[]')) "
734  +     "LOOP\n"
735  +     "   IF item->>'artifact_id' IS NOT NULL THEN\n"
736  +     "    "
737  +     "links=array_append(links,(item->>'artifact_id')::uuid);\n"
738  +     "   END IF;\n"
739  +     "  END LOOP;\n"
740  +     " END IF;\n"
741  +     " IF table_name IN "
742  +     "('native_pilot_runs','native_pilot_observations') "
743  +     "THEN\n"
744  +     "  FOR item IN SELECT value FROM "
745  +     "jsonb_array_elements(coalesce(payload#>'{material_snapshot,statistics,samples}','[]')) "
746  +     "LOOP\n"
747  +     "   IF item->>'id' IS NOT NULL THEN "
748  +     "links=array_append(links,(item->>'id')::uuid); END "
749  +     "IF;\n"
750  +     "  END LOOP;\n"
751  +     "  FOR item IN SELECT value FROM "
752  +     "jsonb_array_elements(coalesce(payload#>'{material_snapshot,statistics,issues}','[]')) "
753  +     "LOOP\n"
754  +     "   IF item->>'id' IS NOT NULL THEN "
755  +     "links=array_append(links,(item->>'id')::uuid); END "
756  +     "IF;\n"
757  +     "  END LOOP;\n"
758  +     "  "
759  +     "item=payload#>'{material_snapshot,statistics,resource,fact}';\n"
760  +     "  IF item->>'id' IS NOT NULL THEN "
761  +     "links=array_append(links,(item->>'id')::uuid); END "
762  +     "IF;\n"
763  +     " END IF;\n"
764  +     " IF table_name='release_packages' THEN\n"
765  +     "  -- FixedObject.ref is a closed, server-resolved "
766  +     "version reference, not arbitrary body UUID text.\n"
767  +     "  FOR item IN SELECT value FROM "
768  +     "jsonb_array_elements(coalesce(payload#>'{body,objects}','[]')) "
769  +     "LOOP\n"
770  +     "   container=item->'ref';\n"
771  +     "   IF "
772  +     "container->>'kind'=ANY(ARRAY['definition','engineering_configuration','process_revision','manufacturing_publication','test_run','pilot_run','issue','change','exception','artifact','work_instruction','control_plan','build_lot','line'])\n"
773  +     "    AND container->>'id' IS NOT NULL THEN "
774  +     "links=array_append(links,(container->>'id')::uuid); "
775  +     "END IF;\n"
776  +     "  END LOOP;\n"
777  +     " END IF;\n"
778  +     " IF table_name IN "
779  +     "('external_handoff_authorizations','external_delivery_intents') "
780  +     "THEN\n"
781  +     "  -- Only closed, owner-verified mapping and "
782  +     "manifest references are source edges.\n"
783  +     "  container=CASE WHEN "
784  +     "table_name='external_handoff_authorizations' THEN "
785  +     "payload#>'{body,declaration}' ELSE payload->'body' "
786  +     "END;\n"
787  +     "  FOR item IN SELECT value FROM "
788  +     "jsonb_array_elements(coalesce(container->'mappings','[]')) "
789  +     "LOOP\n"
790  +     "   IF "
791  +     "item->'ref'->>'kind'=ANY(ARRAY['definition','engineering_configuration','process_revision','part','bom_revision','artifact','work_instruction','control_plan'])\n"
792  +     "    AND item->'ref'->>'id' IS NOT NULL THEN "
793  +     "links=array_append(links,(item->'ref'->>'id')::uuid); "
794  +     "END IF;\n"
795  +     "  END LOOP;\n"
796  +     "  FOR item IN SELECT value FROM "
797  +     "jsonb_array_elements(coalesce(container->'manifest','[]')) "
798  +     "LOOP\n"
799  +     "   IF item->'artifact'->>'id' IS NOT NULL THEN "
800  +     "links=array_append(links,(item->'artifact'->>'id')::uuid); "
801  +     "END IF;\n"
802  +     "  END LOOP;\n"
803  +     " END IF;\n"
804  +     " IF table_name='release_policy_facts' THEN\n"
805  +     "  -- These are Closed DTO configuration references "
806  +     "fixed by the policy owner.\n"
807  +     "  FOREACH key IN ARRAY "
808  +     "ARRAY['definition','engineering_configuration','manufacturing_configuration'] "
809  +     "LOOP\n"
810  +     "   "
811  +     "container=payload#>ARRAY['material','subject_config',key];\n"
812  +     "   IF container->>'id' IS NOT NULL THEN "
813  +     "links=array_append(links,(container->>'id')::uuid); "
814  +     "END IF;\n"
815  +     "  END LOOP;\n"
816  +     " END IF;\n"
817  +     " -- These stored fields are validated Reference "
818  +     "containers. Do not feed the\n"
819  +     " -- whole row or arbitrary content into the "
820  +     "canonical Reference parser.\n"
821  +     " IF "
822  +     "table_name=ANY(ARRAY['proposals','proposal_item_versions','proposal_submissions',\n"
823  +     "  "
824  +     "'category_knowledge_entries','definition_specs']) "
825  +     "THEN\n"
826  +     "  FOREACH key IN ARRAY "
827  +     "ARRAY['source_refs','direct_source_refs','context_refs','baseline_claim_refs'] "
828  +     "LOOP\n"
829  +     "   links=links || "
830  +     "public.m3_lifecycle_typed_links(t,c,payload->key);\n"
831  +     "  END LOOP;\n"
832  +     " END IF;\n"
833  +     " -- Match ItemInput.content_schema and "
834  +     "category_service._references: only\n"
835  +     " -- commercial_target, voice, and competitor have "
836  +     "nested source contracts.\n"
837  +     " IF table_name='proposal_item_versions' AND "
838  +     "payload->>'kind'='commercial_target' THEN\n"
839  +     "  FOREACH key IN ARRAY "
840  +     "ARRAY['target_price','cost','volume'] LOOP\n"
841  +     "   links=links || "
842  +     "public.m3_lifecycle_typed_links(t,c,payload->'content'->key->'source');\n"
843  +     "  END LOOP;\n"
844  +     " ELSIF table_name='category_knowledge_entries' AND "
845  +     "payload->>'kind'='voice' THEN\n"
846  +     "  links=links || "
847  +     "public.m3_lifecycle_typed_links(t,c,payload->'content'->'representative_refs');\n"
848  +     " ELSIF table_name='category_knowledge_entries' AND "
849  +     "payload->>'kind'='competitor' THEN\n"
850  +     "  FOREACH key IN ARRAY "
851  +     "ARRAY['metrics','features','prices'] LOOP\n"
852  +     "   FOR item IN SELECT value FROM "
853  +     "jsonb_array_elements(coalesce(payload->'content'->key,'[]')) "
854  +     "LOOP\n"
855  +     "    links=links || "
856  +     "public.m3_lifecycle_typed_links(t,c,item->'source_ref');\n"
857  +     "   END LOOP;\n"
858  +     "  END LOOP;\n"
859  +     " END IF;\n"
860  +     " IF table_name='proposal_submissions' THEN\n"
861  +     "  container=payload->'frozen_document';\n"
862  +     "  FOREACH key IN ARRAY "
863  +     "ARRAY['source_refs','direct_source_refs','context_refs','baseline_claim_refs'] "
864  +     "LOOP\n"
865  +     "   links=links || "
866  +     "public.m3_lifecycle_typed_links(t,c,container->key);\n"
867  +     "  END LOOP;\n"
868  +     "  FOR item IN SELECT value FROM "
869  +     "jsonb_array_elements(coalesce(container->'items','[]')) "
870  +     "LOOP\n"
871  +     "   links=links || "
872  +     "public.m3_lifecycle_source_links(t,c,'proposal_item_versions',item-ARRAY['item_id','proposal_id']);\n"
873  +     "   -- The frozen read projection records actual "
874  +     "EvidenceLink provenance here.\n"
875  +     "   links=links || "
876  +     "public.m3_lifecycle_typed_links(t,c,item->'evidence_links');\n"
877  +     "  END LOOP;\n"
878  +     " ELSIF table_name='promotion_proofs' THEN\n"
879  +     "  FOR item IN SELECT value FROM "
880  +     "jsonb_array_elements(coalesce(payload->'source_item_refs','[]')) "
881  +     "LOOP\n"
882  +     "   IF item->>'item_id' IS NOT NULL THEN "
883  +     "links=array_append(links,(item->>'item_id')::uuid); "
884  +     "END IF;\n"
885  +     "  END LOOP;\n"
886  +     " END IF;\n"
887  +     " -- Exact persisted EvidenceLink targets "
888  +     "supplement these immutable versions.\n"
889  +     " -- Reverted links and withdrawn Claims still "
890  +     "retain the original historical\n"
891  +     " -- dependency; lifecycle cleanup must not erase "
892  +     "their audit source.\n"
893  +     " IF table_name='proposal_item_versions' AND "
894  +     "payload->>'item_id' IS NOT NULL THEN\n"
895  +     "  target_kind='proposal_item'; "
896  +     "referenced_target=(payload->>'item_id')::uuid;\n"
897  +     "  "
898  +     "referenced_version=(payload->>'version')::integer;\n"
899  +     " ELSIF table_name='category_knowledge_entries' AND "
900  +     "payload->>'id' IS NOT NULL THEN\n"
901  +     "  target_kind='knowledge_entry'; "
902  +     "referenced_target=(payload->>'id')::uuid;\n"
903  +     "  "
904  +     "referenced_version=(payload->>'version')::integer;\n"
905  +     " ELSIF table_name='definition_specs' AND "
906  +     "payload->>'id' IS NOT NULL THEN\n"
907  +     "  target_kind='definition_spec'; "
908  +     "referenced_target=(payload->>'id')::uuid;\n"
909  +     "  SELECT revision INTO referenced_version FROM "
910  +     "public.definition_revisions\n"
911  +     "   WHERE tenant_id=t AND category_id=c AND "
912  +     "id=(payload->>'definition_id')::uuid;\n"
913  +     " END IF;\n"
914  +     " IF referenced_target IS NOT NULL AND "
915  +     "referenced_version IS NOT NULL THEN\n"
916  +     "  SELECT "
917  +     "coalesce(array_agg(link.evidence_id),'{}') INTO "
918  +     "extra FROM public.evidence_links link\n"
919  +     "   WHERE link.tenant_id=t AND link.category_id=c "
920  +     "AND link.target_type=target_kind\n"
921  +     "    AND link.target_id=referenced_target AND "
922  +     "link.target_version=referenced_version;\n"
923  +     "  links=links || extra;\n"
924  +     " END IF;\n"
925  +     " -- Child source rows point to their parent, "
926  +     "whereas dependency traversal needs\n"
927  +     " -- the parent's fixed source children as well. "
928  +     "Keep the actual relational edge.\n"
929  +     " IF table_name='definition_revisions' THEN\n"
930  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
931  +     "FROM (\n"
932  +     "   SELECT id FROM public.definition_sources WHERE "
933  +     "tenant_id=t AND category_id=c\n"
934  +     "    AND definition_id=(payload->>'id')::uuid\n"
935  +     "   UNION ALL SELECT id FROM "
936  +     "public.definition_specs WHERE tenant_id=t AND "
937  +     "category_id=c\n"
938  +     "    AND definition_id=(payload->>'id')::uuid\n"
939  +     "  ) children;\n"
940  +     "  links=links || extra;\n"
941  +     " ELSIF table_name='proposals' THEN\n"
942  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
943  +     "FROM public.proposal_item_versions\n"
944  +     "   WHERE tenant_id=t AND category_id=c AND "
945  +     "proposal_id=(payload->>'id')::uuid;\n"
946  +     "  links=links || extra;\n"
947  +     " ELSIF table_name='proposal_items' THEN\n"
948  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
949  +     "FROM public.proposal_item_versions\n"
950  +     "   WHERE tenant_id=t AND category_id=c AND "
951  +     "item_id=(payload->>'id')::uuid;\n"
952  +     "  links=links || extra;\n"
953  +     " ELSIF table_name='product_target_segments' THEN\n"
954  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
955  +     "FROM public.category_knowledge_entries\n"
956  +     "   WHERE tenant_id=t AND category_id=c AND "
957  +     "lineage_id=(payload->>'segment_lineage_id')::uuid\n"
958  +     "    AND "
959  +     "version=(payload->>'segment_version')::integer;\n"
960  +     "  links=links || extra;\n"
961  +     " ELSIF table_name='parameter_current' THEN\n"
962  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
963  +     "FROM public.parameter_versions\n"
964  +     "   WHERE tenant_id=t AND category_id=c AND "
965  +     "parameter_id=(payload->>'parameter_id')::uuid\n"
966  +     "    AND "
967  +     "version=(payload->>'current_version')::integer;\n"
968  +     "  links=links || extra;\n"
969  +     " END IF;\n"
970  +     " RETURN links;\n"
971  +     "END;\n"
972  +     "$function$\n",
973  +     "m3_lifecycle_row_links(uuid,uuid,text,jsonb)": "CREATE OR REPLACE FUNCTION "
974  +     "public.m3_lifecycle_row_links(t uuid, c uuid, "
975  +     "table_name text, payload jsonb)\n"
976  +     " RETURNS uuid[]\n"
977  +     " LANGUAGE plpgsql\n"
978  +     " STABLE SECURITY DEFINER\n"
979  +     " SET search_path TO 'pg_catalog', 'public', "
980  +     "'pg_temp'\n"
981  +     "AS $function$\n"
982  +     "DECLARE links uuid[]; key text; keys text[];\n"
983  +     "BEGIN\n"
984  +     " "
985  +     "links=public.m3_lifecycle_source_links(t,c,table_name,payload);\n"
986  +     " -- Only the infrequent retention summary needs "
987  +     "host/reverse relationships.\n"
988  +     " -- They must not turn a source-free item INSERT into "
989  +     "a proposal-history scan.\n"
990  +     " keys=CASE table_name\n"
991  +     "  WHEN 'definition_sources' THEN "
992  +     "ARRAY['definition_id']\n"
993  +     "  WHEN 'definition_specs' THEN "
994  +     "ARRAY['definition_id']\n"
995  +     "  WHEN 'proposal_items' THEN ARRAY['proposal_id']\n"
996  +     "  WHEN 'proposal_item_versions' THEN "
997  +     "ARRAY['proposal_id','item_id']\n"
998  +     "  WHEN 'proposal_sources' THEN ARRAY['proposal_id']\n"
999  +     "  WHEN 'proposal_submissions' THEN "
1000 +     "ARRAY['proposal_id']\n"
1001 +     "  WHEN 'proposal_decisions' THEN "
1002 +     "ARRAY['proposal_id','created_definition_id']\n"
1003 +     "  WHEN 'evidence_links' THEN ARRAY['target_id']\n"
1004 +     "  WHEN 'manufacturing_baseline_publications' THEN "
1005 +     "ARRAY['project_id']\n"
1006 +     "  WHEN 'manufacturing_publication_currents' THEN "
1007 +     "ARRAY['series_id']\n"
1008 +     "  WHEN 'manufacturing_publication_documents' THEN "
1009 +     "ARRAY['publication_id']\n"
1010 +     "  WHEN 'native_pilot_runs' THEN ARRAY['project_id']\n"
1011 +     "  WHEN 'native_pilot_currents' THEN "
1012 +     "ARRAY['pilot_id']\n"
1013 +     "  WHEN 'native_pilot_observations' THEN "
1014 +     "ARRAY['pilot_id']\n"
1015 +     "  WHEN 'release_packages' THEN "
1016 +     "ARRAY['project_id','series_id']\n"
1017 +     "  WHEN 'release_package_currents' THEN "
1018 +     "ARRAY['series_id']\n"
1019 +     "  WHEN 'release_decisions' THEN ARRAY['package_id']\n"
1020 +     "  WHEN 'release_policy_facts' THEN "
1021 +     "ARRAY['project_id','series_id']\n"
1022 +     "  WHEN 'release_policy_currents' THEN "
1023 +     "ARRAY['series_id']\n"
1024 +     "  WHEN 'external_handoff_authorizations' THEN "
1025 +     "ARRAY['project_id']\n"
1026 +     "  WHEN 'external_delivery_intents' THEN "
1027 +     "ARRAY['project_id']\n"
1028 +     "  WHEN 'external_receipts' THEN ARRAY['project_id']\n"
1029 +     "  WHEN 'external_handoff_currents' THEN "
1030 +     "ARRAY['project_id']\n"
1031 +     "  ELSE ARRAY[]::text[] END;\n"
1032 +     " FOREACH key IN ARRAY keys LOOP\n"
1033 +     "  IF payload->>key IS NOT NULL THEN "
1034 +     "links=array_append(links,(payload->>key)::uuid); END "
1035 +     "IF;\n"
1036 +     " END LOOP;\n"
1037 +     " RETURN links;\n"
1038 +     "END;\n"
1039 +     "$function$\n",
1040 +     "protect_object_audience_target()": "CREATE OR REPLACE FUNCTION "
1041 +     "public.protect_object_audience_target()\n"
1042 +     " RETURNS trigger\n"
1043 +     " LANGUAGE plpgsql\n"
1044 +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
1045 +     "AS $function$\n"
1046 +     "DECLARE value jsonb; typ text; own_col text; model_col text;\n"
1047 +     " t uuid; c uuid; sid uuid; expected_owner uuid; actual_owner "
1048 +     "uuid; model uuid;\n"
