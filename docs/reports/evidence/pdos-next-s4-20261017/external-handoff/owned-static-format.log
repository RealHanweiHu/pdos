2918 +     "  WHEN 'proposal_revisions' THEN ARRAY['proposal_id']\n"
2919 +     "  WHEN 'proposal_sources' THEN ARRAY['source_id']\n"
2920 +     "  WHEN 'proposal_submissions' THEN ARRAY[]::text[]\n"
2921 +     "  WHEN 'proposal_decisions' THEN ARRAY['submission_id']\n"
