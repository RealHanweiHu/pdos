3002 +     " ELSIF table_name='category_knowledge_entries' AND payload->>'kind'='competitor' THEN\n"
3003 +     "  FOREACH key IN ARRAY ARRAY['metrics','features','prices'] LOOP\n"
3004 +     "   FOR item IN SELECT value FROM jsonb_array_elements(coalesce(payload->'content'->key,'[]')) LOOP\n"
3005 +     "    links=links || public.m3_lifecycle_typed_links(t,c,item->'source_ref');\n"
3006 +     "   END LOOP;\n"
3007 +     "  END LOOP;\n"
3008 +     " END IF;\n"
3009 +     " IF table_name='proposal_submissions' THEN\n"
3010 +     "  container=payload->'frozen_document';\n"
