3163 +     " THEN RAISE EXCEPTION 'audience identity cannot be reassigned' USING ERRCODE='23514'; END IF;\n"
3164 +     " typ=value->>'object_type'; own_col=owners->>typ;\n"
3165 +     " t=(value->>'tenant_id')::uuid; c=(value->>'category_id')::uuid;\n"
3166 +     " sid=(value->>'subject_id')::uuid; expected_owner=(value->>'owner_id')::uuid;\n"
3167 +     " IF own_col IS NULL THEN\n"
3168 +     "  RAISE EXCEPTION 'audience target unavailable' USING ERRCODE='23514';\n"
3169 +     " END IF;\n"
3170 +     " IF typ='variant_revisions' THEN\n"
3171 +     "  IF m3_lock_variant_revision_audience_target(t,c,sid,expected_owner) IS DISTINCT FROM true THEN\n"
3172 +     "   RAISE EXCEPTION 'audience target unavailable' USING ERRCODE='23514';\n"
3173 +     "  END IF;\n"
3174 +     "  IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
3175 +     " END IF;\n"
3176 +     " IF typ='product_variants' THEN\n"
3177 +     "  IF m3_lock_variant_audience_target(t,c,sid,expected_owner) IS DISTINCT FROM true THEN\n"
3178 +     "   RAISE EXCEPTION 'audience target unavailable' USING ERRCODE='23514';\n"
3179 +     "  END IF;\n"
3180 +     "  IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
3181 +     " END IF;\n"
3182 +     " model_col=CASE WHEN typ='products' THEN 'id' WHEN typ='proposals' THEN 'baseline_product_id' ELSE "
3183 +     "'product_id' END;\n"
3184 +     " EXECUTE format('SELECT %I,%I FROM public.%I WHERE tenant_id=$1 AND category_id=$2 AND id=$3',\n"
3185 +     "                own_col,model_col,typ) INTO actual_owner,model USING t,c,sid;\n"
3186 +     " IF actual_owner IS DISTINCT FROM expected_owner THEN\n"
3187 +     "  RAISE EXCEPTION 'audience target unavailable' USING ERRCODE='23514';\n"
3188 +     " END IF;\n"
3189 +     " IF model IS NOT NULL THEN\n"
3190 +     "  PERFORM 1 FROM products WHERE tenant_id=t AND category_id=c AND id=model FOR UPDATE;\n"
3191 +     "  IF NOT FOUND THEN\n"
3192 +     "   RAISE EXCEPTION 'audience model unavailable' USING ERRCODE='23514';\n"
3193 +     "  END IF;\n"
3194 +     " END IF;\n"
3195 +     " EXECUTE format('SELECT %I FROM public.%I\n"
3196 +     "  WHERE tenant_id=$1 AND category_id=$2 AND id=$3 FOR UPDATE',\n"
3197 +     "                own_col,typ) INTO actual_owner USING t,c,sid;\n"
3198 +     " IF actual_owner IS DISTINCT FROM expected_owner THEN\n"
3199 +     "  RAISE EXCEPTION 'audience target unavailable' USING ERRCODE='23514';\n"
3200 +     " END IF;\n"
