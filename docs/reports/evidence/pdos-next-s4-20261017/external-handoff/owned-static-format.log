1547 +     "CREATE FUNCTION public.assert_external_handoff_members(t uuid,target uuid,kind text) RETURNS void\n"
1548 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
1549 +     "\n"
1550 +     "DECLARE v record; r public.action_receipts; c public.confirmations;\n"
1551 +     " proof uuid; expected_status text; event_name text;\n"
1552 +     "BEGIN\n"
1553 +     " IF kind='external_handoff' THEN\n"
1554 +     "  SELECT * INTO STRICT v FROM public.external_handoff_authorizations WHERE tenant_id=t AND "
1555 +     "id=target;\n"
1556 +     "  proof=v.shared_proof_id; expected_status='authorized'; event_name='external_handoff.authorized';\n"
1557 +     "  SELECT * INTO STRICT c FROM public.confirmations WHERE tenant_id=t AND id=proof;\n"
1558 +     "  IF ROW(c.category_id,c.product_id,c.actor_id,c.subject_type,c.subject_id,c.operation,c.revision)\n"
1559 +     "   IS DISTINCT FROM "
1560 +     "ROW(v.category_id,v.product_id,v.actor_id,'product'::varchar,v.product_id,v.operation,v.shared_proof_revision)\n"
1561 +     "   OR c.consumed IS DISTINCT FROM true OR c.token_hash IS DISTINCT FROM v.token_sha256\n"
1562 +     "   OR c.payload_digest IS DISTINCT FROM v.material_sha256 OR c.snapshot IS DISTINCT FROM "
1563 +     "v.input_snapshot->'review'\n"
1564 +     "   OR c.expires_at IS DISTINCT FROM v.proof_expires_at\n"
1565 +     "   OR NOT(c.created_at<=v.proof_consumed_at AND v.proof_consumed_at<=v.created_at\n"
1566 +     "    AND (c.expires_at IS NULL OR v.created_at<c.expires_at)) THEN\n"
1567 +     "   RAISE EXCEPTION 'External handoff requires its original consumed T2 proof' USING ERRCODE='23514'; "
1568 +     "END IF;\n"
1569 +     " ELSIF kind='external_receipt' THEN\n"
1570 +     "  SELECT * INTO STRICT v FROM public.external_receipts WHERE tenant_id=t AND id=target;\n"
1571 +     "  proof=NULL; expected_status='recorded'; event_name='external_receipt.recorded';\n"
1572 +     " ELSE RAISE EXCEPTION 'Unknown external handoff subject' USING ERRCODE='23514'; END IF;\n"
1573 +     " SELECT * INTO STRICT r FROM public.action_receipts WHERE tenant_id=t AND id=v.receipt_id;\n"
1574 +     " IF "
1575 +     "ROW(r.category_id,r.product_id,r.command_id,r.confirmation_id,r.actor_id,r.requester_id,r.operation,\n"
1576 +     "   r.subject_type,r.subject_id,r.subject_revision,r.visibility,r.request_digest,r.intent_digest)\n"
1577 +     "  IS DISTINCT FROM "
1578 +     "ROW(v.category_id,v.product_id,v.command_id,proof,v.actor_id,v.requester_id,v.operation,\n"
1579 +     "   kind::varchar,v.id,v.revision,v.visibility,v.request_digest,v.intent_digest)\n"
1580 +     "  OR r.result IS DISTINCT FROM "
1581 +     "jsonb_build_object('id',v.id,'revision',v.revision,'status',expected_status)\n"
1582 +     "  OR r.created_at<v.created_at\n"
1583 +     "  OR (kind='external_handoff' AND (r.run_id IS NOT NULL OR r.agent_run_id IS NOT NULL\n"
1584 +     "    OR (c.expires_at IS NOT NULL AND r.created_at>=c.expires_at)))\n"
1585 +     "  OR (SELECT count(*) FROM public.action_receipts x WHERE x.tenant_id=t AND x.operation=v.operation\n"
1586 +     "    AND x.subject_type=kind AND x.subject_id=v.id AND x.subject_revision=v.revision)<>1\n"
1587 +     "  OR (SELECT count(*) FROM public.audit_entries a WHERE a.tenant_id=t AND a.receipt_id=r.id)<>1\n"
1588 +     "  OR NOT EXISTS(SELECT 1 FROM public.audit_entries a WHERE a.tenant_id=t AND a.receipt_id=r.id\n"
1589 +     "    AND a.category_id=v.category_id AND a.actor_id=v.actor_id AND a.operation=v.operation AND "
1590 +     "a.created_at>=v.created_at)\n"
1591 +     "  OR (SELECT count(*) FROM public.outbox_events e WHERE e.tenant_id=t AND e.receipt_id=r.id)<>1\n"
1592 +     "  OR NOT EXISTS(SELECT 1 FROM public.outbox_events e WHERE e.tenant_id=t AND e.receipt_id=r.id\n"
1593 +     "    AND e.category_id=v.category_id AND e.actor_id=v.actor_id AND e.type=event_name\n"
1594 +     "    AND e.subject_id=v.id AND e.subject_revision=v.revision AND e.schema_version=1\n"
1595 +     "    AND e.correlation_id=coalesce(r.agent_run_id,r.run_id,v.command_id) AND "
1596 +     "e.created_at>=v.created_at)\n"
1597 +     "  OR v.input_snapshot->>'original_key_sha256' IS NULL\n"
1598 +     "  OR v.input_snapshot->>'original_key_sha256' !~ '^[a-f0-9]{64}$'\n"
1599 +     "  OR (v.input_snapshot->'command') ? 'idempotency_key'\n"
1600 +     "  OR (v.input_snapshot->'command'->'payload') ? 'approval_token'\n"
1601 +     "  OR (v.input_snapshot->'semantic') ? 'approval_token'\n"
1602 +     "  OR NOT EXISTS(SELECT 1 FROM public.request_keys k WHERE k.tenant_id=t AND "
1603 +     "k.category_id=v.category_id\n"
1604 +     "    AND k.receipt_id=r.id AND k.actor_id=v.actor_id AND k.digest=v.request_digest\n"
1605 +     "    AND encode(sha256(convert_to(k.key,'UTF8')),'hex')=v.input_snapshot->>'original_key_sha256') "
1606 +     "THEN\n"
1607 +     "  RAISE EXCEPTION 'External handoff original common group mismatch' USING ERRCODE='23514'; END IF;\n"
1608 +     "END;\n"
1609 +     "$external_handoff$",
1610 +     "CREATE FUNCTION public.assert_external_handoff_write(t uuid,target uuid,kind text) RETURNS void\n"
1611 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
1612 +     "\n"
1613 +     "DECLARE v record; r public.action_receipts; command jsonb; review jsonb; ref jsonb; basis jsonb;\n"
1614 +     " vx xid; rx xid;\n"
1615 +     "BEGIN\n"
1616 +     " IF kind='external_handoff' THEN\n"
1617 +     "  SELECT x.*,x.xmin AS tx INTO STRICT v FROM public.external_handoff_authorizations x WHERE "
1618 +     "x.tenant_id=t AND x.id=target;\n"
1619 +     " ELSIF kind='external_receipt' THEN\n"
1620 +     "  SELECT x.*,x.xmin AS tx INTO STRICT v FROM public.external_receipts x WHERE x.tenant_id=t AND "
1621 +     "x.id=target;\n"
1622 +     " ELSE RAISE EXCEPTION 'Unknown external handoff subject' USING ERRCODE='23514'; END IF;\n"
1623 +     " vx=v.tx;\n"
1624 +     " SELECT * INTO STRICT r FROM public.action_receipts WHERE tenant_id=t AND id=v.receipt_id;\n"
1625 +     " SELECT xmin INTO rx FROM public.action_receipts WHERE tenant_id=t AND id=v.receipt_id;\n"
1626 +     " PERFORM public.assert_external_handoff_members(t,target,kind);\n"
1627 +     " command=v.input_snapshot->'command'; review=v.input_snapshot->'review';\n"
1628 +     " IF v.actor_id IS DISTINCT FROM public.scope_actor() OR v.requester_id IS DISTINCT FROM "
1629 +     "public.scope_requester()\n"
1630 +     "  OR v.writer_id<>v.actor_id OR NOT public.category_access(t,v.category_id,true)\n"
1631 +     "  OR NOT EXISTS(SELECT 1 FROM public.principals p WHERE p.tenant_id=t AND p.id=v.actor_id AND "
1632 +     "p.active)\n"
1633 +     "  OR NOT EXISTS(SELECT 1 FROM public.principals p WHERE p.tenant_id=t AND p.id=v.requester_id AND "
1634 +     "p.kind='human' AND p.active)\n"
1635 +     "  OR (v.actor_id<>v.requester_id AND r.run_id IS NULL AND r.agent_run_id IS NULL)\n"
1636 +     "  OR vx IS DISTINCT FROM rx\n"
1637 +     "  OR (SELECT array_agg(key ORDER BY key) FROM jsonb_object_keys(v.input_snapshot) key)\n"
1638 +     "    IS DISTINCT FROM ARRAY['command','original_key_sha256','review','semantic']\n"
1639 +     "  OR command->>'operation' IS DISTINCT FROM v.operation OR command->>'command_id' IS DISTINCT FROM "
1640 +     "v.command_id::text\n"
1641 +     "  OR command->>'category_id' IS DISTINCT FROM v.category_id::text OR command->>'product_id' IS "
1642 +     "DISTINCT FROM v.product_id::text\n"
1643 +     "  OR command->'payload' IS DISTINCT FROM v.input_snapshot->'semantic'\n"
1644 +     "  OR NOT COALESCE((command->'source_read_set') @> v.required_source_read_set,false)\n"
1645 +     "  OR NOT COALESCE(v.required_source_read_set @> (command->'source_read_set'),false)\n"
1646 +     "  OR jsonb_array_length(command->'source_read_set')<>jsonb_array_length(v.required_source_read_set)\n"
1647 +     "  OR review->>'operation' IS DISTINCT FROM v.operation\n"
1648 +     "  OR review->'required_source_read_set' IS DISTINCT FROM v.required_source_read_set\n"
1649 +     "  OR review->'read_basis' IS DISTINCT FROM v.source_basis\n"
1650 +     "  OR v.body->'scope' IS DISTINCT FROM "
1651 +     "jsonb_build_object('tenant_id',t,'product_id',v.product_id,'project_id',v.project_id)\n"
1652 +     "  OR v.body->>'category_id' IS DISTINCT FROM v.category_id::text\n"
1653 +     "  OR v.material_snapshot->'scope' IS DISTINCT FROM v.body->'scope'\n"
1654 +     "  OR v.material_snapshot->>'category_id' IS DISTINCT FROM v.category_id::text\n"
1655 +     "  OR v.body->'sources' IS DISTINCT FROM v.sources\n"
1656 +     "  OR v.body->'required_source_read_set' IS DISTINCT FROM v.required_source_read_set\n"
1657 +     "  OR NOT EXISTS(SELECT 1 FROM public.products p WHERE p.tenant_id=t AND p.category_id=v.category_id\n"
1658 +     "    AND p.id=v.product_id AND p.revision::text=command->>'expected_revision')\n"
1659 +     "  OR NOT EXISTS(SELECT 1 FROM public.projects p WHERE p.tenant_id=t AND p.category_id=v.category_id\n"
1660 +     "    AND p.product_id=v.product_id AND p.id=v.project_id)\n"
1661 +     "  OR NOT public.direct_source_set_visible(t,v.category_id,v.product_id,v.required_source_read_set)\n"
1662 +     "  OR (SELECT count(DISTINCT x->>'artifact_id') FROM jsonb_array_elements(v.required_source_read_set) "
1663 +     "x)\n"
1664 +     "    <>jsonb_array_length(v.required_source_read_set)\n"
1665 +     "  OR EXISTS(SELECT 1 FROM public.audit_entries x WHERE x.tenant_id=t AND x.receipt_id=v.receipt_id "
1666 +     "AND x.xmin IS DISTINCT FROM vx)\n"
1667 +     "  OR EXISTS(SELECT 1 FROM public.outbox_events x WHERE x.tenant_id=t AND x.receipt_id=v.receipt_id "
1668 +     "AND x.xmin IS DISTINCT FROM vx)\n"
1669 +     "  OR NOT EXISTS(SELECT 1 FROM public.request_keys k WHERE k.tenant_id=t AND "
1670 +     "k.receipt_id=v.receipt_id\n"
1671 +     "    AND k.actor_id=v.actor_id AND k.digest=v.request_digest AND k.xmin=vx\n"
1672 +     "    AND encode(sha256(convert_to(k.key,'UTF8')),'hex')=v.input_snapshot->>'original_key_sha256') "
1673 +     "THEN\n"
1674 +     "  RAISE EXCEPTION 'External handoff requires actual scope and one common transaction' USING "
1675 +     "ERRCODE='23514'; END IF;\n"
1676 +     " IF jsonb_typeof(v.source_basis->'artifact_sources') IS DISTINCT FROM 'object'\n"
1677 +     "  OR (SELECT count(*) FROM "
1678 +     "jsonb_object_keys(v.source_basis->'artifact_sources'))<>jsonb_array_length(v.required_source_read_set) "
1679 +     "THEN\n"
1680 +     "  RAISE EXCEPTION 'External handoff complete direct source basis required' USING ERRCODE='23514'; END "
1681 +     "IF;\n"
1682 +     " FOR ref IN SELECT value FROM jsonb_array_elements(v.required_source_read_set) LOOP\n"
1683 +     "  basis=v.source_basis->'artifact_sources'->(ref->>'artifact_id');\n"
1684 +     "  IF basis IS NULL OR jsonb_typeof(ref->'expected_revision') IS DISTINCT FROM 'number'\n"
1685 +     "   OR NOT EXISTS(SELECT 1 FROM public.artifact_versions a WHERE a.tenant_id=t AND "
1686 +     "a.category_id=v.category_id\n"
1687 +     "    AND a.id::text=ref->>'artifact_id' AND a.revision::text=ref->>'expected_revision' AND "
1688 +     "a.status='active'\n"
1689 +     "    AND a.revision::text=basis->>'revision' AND a.content_hash=basis->>'sha256'\n"
1690 +     "    AND a.owner_id::text=basis->>'owner_id' AND a.visibility=basis->>'visibility'\n"
1691 +     "    AND (v.visibility='private' OR a.visibility<>'private')\n"
1692 +     "    AND (a.original_id IS NULL OR EXISTS(SELECT 1 FROM public.uploaded_originals o\n"
1693 +     "     JOIN public.original_security sec ON sec.tenant_id=o.tenant_id AND sec.original_id=o.id\n"
1694 +     "     WHERE o.tenant_id=t AND o.category_id=v.category_id AND o.id=a.original_id AND "
1695 +     "o.status='parsed'\n"
1696 +     "      AND o.id::text=basis->>'original_id' AND o.revision::text=basis->>'original_revision'\n"
1697 +     "      AND o.content_hash=basis->>'original_sha256' AND o.owner_id::text=basis->>'original_owner_id'\n"
1698 +     "      AND o.visibility=basis->>'original_visibility' AND sec.epoch::text=basis->>'security_epoch'\n"
1699 +     "      AND sec.source_state='active' AND sec.disposition='active' AND (v.visibility='private' OR "
1700 +     "o.visibility<>'private')))) THEN\n"
1701 +     "   RAISE EXCEPTION 'External handoff direct source version security or audience changed' USING "
1702 +     "ERRCODE='23514'; END IF;\n"
1703 +     " END LOOP;\n"
1704 +     " IF EXISTS(SELECT 1 FROM jsonb_array_elements(v.sources) src WHERE src->>'kind'='artifact' AND NOT "
1705 +     "EXISTS(\n"
1706 +     "   SELECT 1 FROM jsonb_array_elements(v.required_source_read_set) rd\n"
1707 +     "   WHERE rd->>'artifact_id'=src->>'id' AND rd->'expected_revision'=src->'revision')) THEN\n"
1708 +     "  RAISE EXCEPTION 'External handoff source omitted from direct read set' USING ERRCODE='23514'; END "
1709 +     "IF;\n"
1710 +     "END;\n"
1711 +     "$external_handoff$",
1712 +     "CREATE FUNCTION public.assert_external_handoff_authorization(t uuid,target uuid) RETURNS void\n"
1713 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
1714 +     "\n"
1715 +     "DECLARE v public.external_handoff_authorizations; p public.release_packages; d "
1716 +     "public.release_decisions;\n"
1717 +     " i public.external_delivery_intents; c public.confirmations; auth jsonb; ref jsonb; vx xid; cx xid; "
1718 +     "ix xid;\n"
1719 +     "BEGIN\n"
1720 +     " SELECT * INTO STRICT v FROM public.external_handoff_authorizations WHERE tenant_id=t AND id=target;\n"
1721 +     " SELECT xmin INTO vx FROM public.external_handoff_authorizations WHERE tenant_id=t AND id=target;\n"
1722 +     " SELECT * INTO STRICT c FROM public.confirmations WHERE tenant_id=t AND id=v.shared_proof_id;\n"
1723 +     " SELECT xmin INTO cx FROM public.confirmations WHERE tenant_id=t AND id=v.shared_proof_id;\n"
1724 +     " SELECT * INTO STRICT p FROM public.release_packages WHERE tenant_id=t AND id=v.package_id;\n"
1725 +     " SELECT * INTO STRICT i FROM public.external_delivery_intents WHERE tenant_id=t AND handoff_id=v.id "
1726 +     "AND handoff_revision=v.revision;\n"
1727 +     " SELECT xmin INTO ix FROM public.external_delivery_intents WHERE tenant_id=t AND id=i.id;\n"
1728 +     " PERFORM public.assert_external_handoff_write(t,target,'external_handoff');\n"
1729 +     " auth=v.authority_snapshot;\n"
1730 +     " IF v.actor_id<>v.requester_id OR vx IS DISTINCT FROM cx OR vx IS DISTINCT FROM ix\n"
1731 +     "  OR NOT EXISTS(SELECT 1 FROM public.principals a WHERE a.tenant_id=t AND a.id=v.actor_id AND "
1732 +     "a.kind='human' AND a.active)\n"
1733 +     "  OR ROW(p.category_id,p.product_id,p.project_id,p.revision) IS DISTINCT FROM "
1734 +     "ROW(v.category_id,v.product_id,v.project_id,v.package_revision)\n"
1735 +     "  OR NOT EXISTS(SELECT 1 FROM public.release_package_currents cur WHERE cur.tenant_id=t AND "
1736 +     "cur.product_id=p.product_id\n"
1737 +     "    AND cur.project_id=p.project_id AND cur.series_id=p.series_id AND cur.version_id=p.id AND "
1738 +     "cur.revision=p.revision)\n"
1739 +     "  OR NOT EXISTS(SELECT 1 FROM public.external_handoff_currents cur WHERE cur.tenant_id=t AND "
1740 +     "cur.handoff_id=v.id\n"
1741 +     "    AND cur.handoff_revision=v.revision AND cur.intent_id=i.id AND cur.intent_revision=i.revision\n"
1742 +     "    AND cur.receipt_count=0 AND cur.epoch=1 AND cur.xmin=vx)\n"
1743 +     "  OR v.shared_proof_revision::text IS DISTINCT FROM "
1744 +     "v.input_snapshot->'command'->>'expected_revision'\n"
1745 +     "  OR (v.body||jsonb_build_object('prepared_at',null)) IS DISTINCT FROM "
1746 +     "v.input_snapshot->'review'->'after'\n"
1747 +     "  OR ((v.body->'declaration')-'approval_token') IS DISTINCT FROM v.input_snapshot->'semantic'\n"
1748 +     "  OR COALESCE(v.body->'declaration'->'approval_token'<>'null'::jsonb,false)\n"
1749 +     "  OR v.body->'signers' IS DISTINCT FROM jsonb_build_array(v.actor_id)\n"
1750 +     "  OR v.body->>'state' IS DISTINCT FROM 'READY' OR v.body->'unknown' IS DISTINCT FROM '[]'::jsonb\n"
1751 +     "  OR v.body->'blocked' IS DISTINCT FROM '[]'::jsonb\n"
1752 +     "  OR v.body->'network_send' IS DISTINCT FROM 'false'::jsonb\n"
1753 +     "  OR v.body->'external_received' IS DISTINCT FROM 'false'::jsonb\n"
1754 +     "  OR v.body->'external_effective' IS DISTINCT FROM 'false'::jsonb\n"
1755 +     "  OR v.body->>'manifest_sha256' IS DISTINCT FROM v.manifest_sha256\n"
1756 +     "  OR v.body->>'mappings_sha256' IS DISTINCT FROM v.mappings_sha256\n"
1757 +     "  OR v.body->>'content_sha256' IS DISTINCT FROM v.content_sha256\n"
1758 +     "  OR v.body->>'package_sha256' IS DISTINCT FROM p.body->>'body_sha256'\n"
1759 +     "  OR v.body->'declaration'->'package' IS DISTINCT FROM "
1760 +     "jsonb_build_object('id',p.id,'revision',p.revision)\n"
1761 +     "  OR v.body->'declaration'->>'project_id' IS DISTINCT FROM v.project_id::text\n"
1762 +     "  OR v.body->'declaration'->>'purpose' IS DISTINCT FROM v.purpose\n"
1763 +     "  OR v.body->'declaration'->>'visibility' IS DISTINCT FROM v.visibility\n"
1764 +     "  OR v.material_snapshot->'package' IS DISTINCT FROM p.body\n"
1765 +     "  OR v.material_snapshot->'package_ref' IS DISTINCT FROM v.body->'declaration'->'package'\n"
1766 +     "  OR (p.visibility='private' AND v.visibility<>'private')\n"
1767 +     "  OR v.input_snapshot->'review'->'authority' IS DISTINCT FROM auth\n"
1768 +     "  OR auth->'scope' IS DISTINCT FROM v.body->'scope' OR auth->>'subject_id' IS DISTINCT FROM "
1769 +     "v.actor_id::text\n"
1770 +     "  OR auth->>'operation' IS DISTINCT FROM v.operation OR auth->>'purpose' IS DISTINCT FROM v.purpose\n"
1771 +     "  OR auth->'authorized' IS DISTINCT FROM 'true'::jsonb OR auth->'qualified' IS DISTINCT FROM "
1772 +     "'true'::jsonb\n"
1773 +     "  OR NOT public.capture_authority_time_current(auth,v.created_at)\n"
1774 +     "  OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(auth->'fact_refs')) THEN\n"
1775 +     "  RAISE EXCEPTION 'External authorization requires the actual package current named T2 and intent' "
1776 +     "USING ERRCODE='23514'; END IF;\n"
1777 +     " FOR d IN SELECT * FROM public.release_decisions WHERE tenant_id=t AND id "
1778 +     "IN(v.engineering_decision_id,v.manufacturing_decision_id) LOOP\n"
1779 +     "  IF ROW(d.category_id,d.product_id,d.project_id,d.package_id,d.package_revision)\n"
1780 +     "    IS DISTINCT FROM ROW(v.category_id,v.product_id,v.project_id,p.id,p.revision)\n"
1781 +     "   OR (d.id=v.engineering_decision_id AND (d.discipline<>'engineering' OR "
1782 +     "d.revision<>v.engineering_decision_revision))\n"
1783 +     "   OR (d.id=v.manufacturing_decision_id AND (d.discipline<>'manufacturing' OR "
1784 +     "d.revision<>v.manufacturing_decision_revision))\n"
1785 +     "   OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(v.material_snapshot->'decisions') actual\n"
1786 +     "    WHERE actual->'ref'=jsonb_build_object('id',d.id,'revision',d.revision) AND "
1787 +     "actual->'plan'=d.body) THEN\n"
1788 +     "   RAISE EXCEPTION 'External handoff requires both actual independent decisions' USING "
1789 +     "ERRCODE='23514'; END IF;\n"
1790 +     " END LOOP;\n"
1791 +     " FOR ref IN SELECT value FROM jsonb_array_elements(auth->'fact_refs') LOOP\n"
1792 +     "  IF NOT EXISTS(SELECT 1 FROM public.professional_authority_facts f JOIN "
1793 +     "public.professional_authority_current cur\n"
1794 +     "   ON cur.tenant_id=f.tenant_id AND cur.category_id=f.category_id AND cur.product_id=f.product_id AND "
1795 +     "cur.project_id=f.project_id\n"
1796 +     "    AND cur.subject_id=f.subject_id AND cur.kind=f.kind AND cur.series_id=f.series_id AND "
1797 +     "cur.fact_id=f.id AND cur.fact_revision=f.revision\n"
1798 +     "   WHERE f.tenant_id=t AND f.category_id=v.category_id AND f.product_id=v.product_id AND "
1799 +     "f.project_id=v.project_id\n"
1800 +     "    AND f.subject_id=v.actor_id AND f.id::text=ref->>'id' AND f.revision::text=ref->>'revision'\n"
1801 +     "    AND cur.epoch::text=ref->>'epoch' AND f.fact_sha256=ref->>'fact_sha256' AND "
1802 +     "f.state=ref->>'state'\n"
1803 +     "    AND f.role=ref->>'role' AND f.kind=ref->>'kind' AND f.series_id::text=ref->>'series_id'\n"
1804 +     "    AND f.issuer_key=ref->>'issuer_key' AND f.issuer_version=ref->>'issuer_version' AND "
1805 +     "f.nature=ref->>'nature'\n"
1806 +     "    AND f.operations=ref->'operations' AND f.purposes=ref->'purposes'\n"
1807 +     "    AND f.valid_from IS NOT DISTINCT FROM (ref->>'valid_from')::timestamptz\n"
1808 +     "    AND f.valid_until IS NOT DISTINCT FROM (ref->>'valid_until')::timestamptz) THEN\n"
1809 +     "   RAISE EXCEPTION 'External authorization professional fact or Current changed' USING "
1810 +     "ERRCODE='23514'; END IF;\n"
1811 +     " END LOOP;\n"
1812 +     " IF NOT EXISTS(SELECT 1 FROM jsonb_array_elements_text(auth->'roles') AS roles(role_name)\n"
1813 +     "   WHERE role_name IN ('engineering','manufacturing','quality') AND NOT EXISTS(\n"
1814 +     "    SELECT kind FROM unnest(ARRAY['duty','qualification']) kind WHERE NOT EXISTS(\n"
1815 +     "     SELECT 1 FROM jsonb_array_elements(auth->'fact_refs') f WHERE f->>'kind'=kind AND "
1816 +     "f->>'role'=role_name\n"
1817 +     "      AND f->>'state'='active' AND (f->'operations') @> jsonb_build_array(v.operation)\n"
1818 +     "      AND (f->'purposes') @> jsonb_build_array(v.purpose)\n"
1819 +     "      AND (f->>'valid_from')::timestamptz<=v.created_at AND "
1820 +     "v.created_at<(f->>'valid_until')::timestamptz))) THEN\n"
1821 +     "  RAISE EXCEPTION 'External authorization needs its actual applicable duty and qualification' USING "
1822 +     "ERRCODE='23514'; END IF;\n"
1823 +     "END;\n"
1824 +     "$external_handoff$",
1825 +     "CREATE FUNCTION public.assert_external_delivery_intent(t uuid,target uuid) RETURNS void\n"
1826 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
1827 +     "\n"
1828 +     "DECLARE v public.external_delivery_intents; a public.external_handoff_authorizations; expected jsonb; "
1829 +     "vx xid; ax xid;\n"
1830 +     "BEGIN\n"
1831 +     " SELECT * INTO STRICT v FROM public.external_delivery_intents WHERE tenant_id=t AND id=target;\n"
1832 +     " SELECT xmin INTO vx FROM public.external_delivery_intents WHERE tenant_id=t AND id=target;\n"
1833 +     " SELECT * INTO STRICT a FROM public.external_handoff_authorizations WHERE tenant_id=t AND "
1834 +     "id=v.handoff_id;\n"
1835 +     " SELECT xmin INTO ax FROM public.external_handoff_authorizations WHERE tenant_id=t AND "
1836 +     "id=v.handoff_id;\n"
1837 +     " expected=jsonb_build_object('handoff',jsonb_build_object('id',a.id,'revision',a.revision),\n"
1838 +     "  "
1839 +     "'manifest_sha256',a.manifest_sha256,'mappings_sha256',a.mappings_sha256,'content_sha256',a.content_sha256,'network_send',false);\n"
1840 +     " expected=expected||(SELECT jsonb_object_agg(key,value) FROM jsonb_each(a.body->'declaration')\n"
1841 +     "  WHERE key IN "
1842 +     "('package','engineering_decision','manufacturing_decision','subject_config','release_scope','purpose',\n"
1843 +     "   'destination','external_id','manifest','mappings'));\n"
1844 +     " IF vx IS DISTINCT FROM ax OR v.body IS DISTINCT FROM expected\n"
1845 +     "  OR v.authorization_sha256 IS DISTINCT FROM a.body_sha256\n"
1846 +     "  OR "
1847 +     "ROW(v.category_id,v.product_id,v.project_id,v.owner_id,v.visibility,v.handoff_revision,v.command_id,v.receipt_id,\n"
1848 +     "    v.manifest_sha256,v.mappings_sha256,v.content_sha256)\n"
1849 +     "   IS DISTINCT FROM "
1850 +     "ROW(a.category_id,a.product_id,a.project_id,a.owner_id,a.visibility,a.revision,a.command_id,a.receipt_id,\n"
1851 +     "    a.manifest_sha256,a.mappings_sha256,a.content_sha256)\n"
1852 +     "  OR v.destination IS DISTINCT FROM a.body->'declaration'->'destination'\n"
1853 +     "  OR v.external_id IS DISTINCT FROM a.body->'declaration'->>'external_id' THEN\n"
1854 +     "  RAISE EXCEPTION 'Delivery intent must fix its original authorization in the same transaction' USING "
1855 +     "ERRCODE='23514'; END IF;\n"
1856 +     "END;\n"
1857 +     "$external_handoff$",
1858 +     "CREATE FUNCTION public.assert_external_receipt(t uuid,target uuid) RETURNS void\n"
1859 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
1860 +     "\n"
1861 +     "DECLARE v public.external_receipts; a public.external_handoff_authorizations; i "
1862 +     "public.external_delivery_intents;\n"
1863 +     " prior public.external_receipts; art public.artifact_versions; cur public.external_handoff_currents;\n"
1864 +     " position text[]; line text; vx xid; cx xid;\n"
1865 +     "BEGIN\n"
1866 +     " SELECT * INTO STRICT v FROM public.external_receipts WHERE tenant_id=t AND id=target;\n"
1867 +     " SELECT xmin INTO vx FROM public.external_receipts WHERE tenant_id=t AND id=target;\n"
1868 +     " SELECT * INTO STRICT a FROM public.external_handoff_authorizations WHERE tenant_id=t AND "
1869 +     "id=v.handoff_id;\n"
1870 +     " SELECT * INTO STRICT i FROM public.external_delivery_intents WHERE tenant_id=t AND id=v.intent_id;\n"
1871 +     " SELECT * INTO STRICT cur FROM public.external_handoff_currents WHERE tenant_id=t AND "
1872 +     "handoff_id=v.handoff_id;\n"
1873 +     " SELECT xmin INTO cx FROM public.external_handoff_currents WHERE tenant_id=t AND id=cur.id;\n"
1874 +     " PERFORM public.assert_external_handoff_write(t,target,'external_receipt');\n"
1875 +     " IF vx IS DISTINCT FROM cx OR cur.latest_receipt_id<>v.id OR cur.latest_receipt_revision<>v.revision\n"
1876 +     "  OR cur.receipt_count<>v.sequence OR cur.epoch<>v.sequence+1\n"
1877 +     "  OR cur.projection IS DISTINCT FROM v.projection_after OR cur.projection_sha256 IS DISTINCT FROM "
1878 +     "v.projection_sha256\n"
1879 +     "  OR (v.body||jsonb_build_object('received_at',null)) IS DISTINCT FROM "
1880 +     "v.input_snapshot->'review'->'after'\n"
1881 +     "  OR v.input_snapshot->'semantic'->'handoff' IS DISTINCT FROM "
1882 +     "jsonb_build_object('id',a.id,'revision',a.revision)\n"
1883 +     "  OR v.input_snapshot->'semantic'->'intent' IS DISTINCT FROM "
1884 +     "jsonb_build_object('id',i.id,'revision',i.revision)\n"
1885 +     "  OR v.input_snapshot->'semantic'->'source' IS DISTINCT FROM v.source\n"
1886 +     "  OR v.body->'original' IS DISTINCT FROM v.original OR v.body->'source' IS DISTINCT FROM v.source\n"
1887 +     "  OR NOT(v.sources @> jsonb_build_array(v.source))\n"
1888 +     "  OR v.body->'issuer' IS DISTINCT FROM v.issuer_snapshot\n"
1889 +     "  OR v.body->>'state' IS DISTINCT FROM 'READY' OR v.body->'unknown' IS DISTINCT FROM '[]'::jsonb\n"
1890 +     "  OR v.body->'network_send' IS DISTINCT FROM 'false'::jsonb\n"
1891 +     "  OR (v.body->>'received_at')::timestamptz IS DISTINCT FROM v.received_at\n"
1892 +     "  OR v.material_snapshot->'handoff' IS DISTINCT FROM "
1893 +     "jsonb_build_object('id',a.id,'revision',a.revision)\n"
1894 +     "  OR v.material_snapshot->'intent' IS DISTINCT FROM "
1895 +     "jsonb_build_object('id',i.id,'revision',i.revision)\n"
1896 +     "  OR v.material_snapshot->'authorization' IS DISTINCT FROM a.body\n"
1897 +     "  OR v.material_snapshot->'source' IS DISTINCT FROM v.source OR v.material_snapshot->'original' IS "
1898 +     "DISTINCT FROM v.original\n"
1899 +     "  OR v.material_snapshot->'issuer' IS DISTINCT FROM v.issuer_snapshot\n"
1900 +     "  OR v.original->'handoff' IS DISTINCT FROM jsonb_build_object('id',a.id,'revision',a.revision)\n"
1901 +     "  OR v.original->'intent' IS DISTINCT FROM jsonb_build_object('id',i.id,'revision',i.revision)\n"
1902 +     "  OR v.original->'destination' IS DISTINCT FROM v.destination OR v.original->>'external_id' IS "
1903 +     "DISTINCT FROM v.external_id\n"
1904 +     "  OR v.original->>'external_receipt_id' IS DISTINCT FROM v.external_receipt_id\n"
1905 +     "  OR v.original->>'manifest_sha256' IS DISTINCT FROM v.manifest_sha256\n"
1906 +     "  OR v.original->'release_scope' IS DISTINCT FROM v.release_scope\n"
1907 +     "  OR v.original->>'stage' IS DISTINCT FROM v.stage OR v.original->>'outcome' IS DISTINCT FROM "
1908 +     "v.outcome\n"
1909 +     "  OR (v.original->>'occurred_at')::timestamptz IS DISTINCT FROM v.occurred_at\n"
1910 +     "  OR v.original->'reconciles' IS DISTINCT FROM (CASE WHEN v.reconciles_id IS NULL THEN 'null'::jsonb\n"
1911 +     "    ELSE jsonb_build_object('id',v.reconciles_id,'revision',v.reconciles_revision) END)\n"
1912 +     "  OR v.issuer_snapshot->>'system' IS DISTINCT FROM v.destination->>'system'\n"
1913 +     "  OR NOT COALESCE(length(v.issuer_snapshot->>'key')>0 AND length(v.issuer_snapshot->>'version')>0\n"
1914 +     "    AND length(v.issuer_snapshot->>'subject_id')>0 AND (v.issuer_snapshot->>'epoch')::integer>0\n"
1915 +     "    AND (v.issuer_snapshot->>'proof_sha256') ~ '^[a-f0-9]{64}$',false) THEN\n"
1916 +     "  RAISE EXCEPTION 'External receipt must retain its actual original issuer and Current atom' USING "
1917 +     "ERRCODE='23514'; END IF;\n"
1918 +     " position=regexp_match(v.source->>'position','^line:([1-9][0-9]*);quote_sha256:([a-f0-9]{64})$');\n"
1919 +     " IF v.source->>'kind' IS DISTINCT FROM 'artifact' OR position IS NULL THEN\n"
1920 +     "  RAISE EXCEPTION 'External receipt needs its exact original artifact line' USING ERRCODE='23514'; "
1921 +     "END IF;\n"
1922 +     " SELECT * INTO STRICT art FROM public.artifact_versions WHERE tenant_id=t AND "
1923 +     "category_id=v.category_id\n"
1924 +     "  AND id::text=v.source->>'id' AND revision::text=v.source->>'revision' AND status='active';\n"
1925 +     " "
1926 +     "line=(regexp_split_to_array(art.content,E'\\r\\n|[\\n\\r\\013\\014\\034-\\036\\u0085\\u2028\\u2029]'))[position[1]::integer];\n"
1927 +     " IF line IS NULL OR encode(sha256(convert_to(line,'UTF8')),'hex')<>position[2] OR line::jsonb IS "
1928 +     "DISTINCT FROM v.original THEN\n"
1929 +     "  RAISE EXCEPTION 'External receipt original line or hash changed' USING ERRCODE='23514'; END IF;\n"
1930 +     " IF v.reconciles_id IS NOT NULL THEN\n"
1931 +     "  SELECT * INTO STRICT prior FROM public.external_receipts WHERE tenant_id=t AND id=v.reconciles_id;\n"
1932 +     "  IF prior.sequence>=v.sequence OR prior.outcome NOT IN ('unknown','rejected','failed') OR "
1933 +     "v.outcome='unknown'\n"
1934 +     "   OR ROW(prior.stage,prior.external_id,prior.manifest_sha256) IS DISTINCT FROM "
1935 +     "ROW(v.stage,v.external_id,v.manifest_sha256)\n"
1936 +     "   OR prior.destination IS DISTINCT FROM v.destination OR prior.release_scope IS DISTINCT FROM "
1937 +     "v.release_scope THEN\n"
1938 +     "   RAISE EXCEPTION 'External reconciliation must append to its exact unresolved occurrence' USING "
1939 +     "ERRCODE='23514'; END IF;\n"
1940 +     " ELSIF v.stage='sent' AND EXISTS(SELECT 1 FROM public.external_receipts old\n"
1941 +     "   WHERE old.tenant_id=t AND old.handoff_id=v.handoff_id AND old.intent_id=v.intent_id AND "
1942 +     "old.sequence<v.sequence\n"
1943 +     "    AND old.stage='sent' AND old.outcome='unknown' AND NOT EXISTS(SELECT 1 FROM "
1944 +     "public.external_receipts resolved\n"
1945 +     "     WHERE resolved.tenant_id=t AND resolved.reconciles_id=old.id AND "
1946 +     "resolved.reconciles_revision=old.revision)) THEN\n"
1947 +     "  RAISE EXCEPTION 'Unknown delivery requires reconciliation of its original intent before another "
1948 +     "send record' USING ERRCODE='23514';\n"
1949 +     " END IF;\n"
1950 +     "END;\n"
1951 +     "$external_handoff$",
1952 +     "CREATE FUNCTION public.protect_external_handoff_current() RETURNS trigger\n"
1953 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
1954 +     "\n"
1955 +     "BEGIN\n"
1956 +     " IF TG_OP='INSERT' THEN\n"
1957 +     "  IF NEW.receipt_count=0 AND NEW.epoch=1 AND NEW.latest_receipt_id IS NULL AND "
1958 +     "NEW.latest_receipt_revision IS NULL THEN RETURN NEW; END IF;\n"
1959 +     " ELSIF TG_OP='UPDATE' THEN\n"
1960 +     "  IF "
1961 +     "(to_jsonb(NEW)-ARRAY['receipt_count','latest_receipt_id','latest_receipt_revision','epoch','projection','projection_sha256'])\n"
1962 +     "    IS NOT DISTINCT FROM "
1963 +     "(to_jsonb(OLD)-ARRAY['receipt_count','latest_receipt_id','latest_receipt_revision','epoch','projection','projection_sha256'])\n"
1964 +     "   AND NEW.receipt_count=OLD.receipt_count+1 AND NEW.epoch=OLD.epoch+1\n"
1965 +     "   AND EXISTS(SELECT 1 FROM public.external_receipts r WHERE r.tenant_id=NEW.tenant_id AND "
1966 +     "r.id=NEW.latest_receipt_id\n"
1967 +     "    AND r.handoff_id=NEW.handoff_id AND r.intent_id=NEW.intent_id AND "
1968 +     "r.revision=NEW.latest_receipt_revision\n"
1969 +     "    AND r.sequence=NEW.receipt_count AND r.previous_sequence IS NOT DISTINCT FROM "
1970 +     "NULLIF(OLD.receipt_count,0)\n"
1971 +     "    AND r.previous_receipt_id IS NOT DISTINCT FROM OLD.latest_receipt_id\n"
1972 +     "    AND r.previous_receipt_revision IS NOT DISTINCT FROM OLD.latest_receipt_revision\n"
1973 +     "    AND r.projection_after=NEW.projection AND r.projection_sha256=NEW.projection_sha256) THEN RETURN "
1974 +     "NEW; END IF;\n"
1975 +     " END IF;\n"
1976 +     " RAISE EXCEPTION 'External handoff Current advances one exact receipt and epoch' USING "
1977 +     "ERRCODE='23514';\n"
1978 +     "END;\n"
1979 +     "$external_handoff$",
1980 +     "CREATE FUNCTION public.require_external_handoff_current() RETURNS trigger\n"
1981 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
1982 +     "\n"
1983 +     "DECLARE cur public.external_handoff_currents; a public.external_handoff_authorizations;\n"
1984 +     " i public.external_delivery_intents; cx xid; ax xid; ix xid;\n"
1985 +     "BEGIN\n"
1986 +     " SELECT * INTO STRICT cur FROM public.external_handoff_currents WHERE tenant_id=NEW.tenant_id AND "
1987 +     "id=NEW.id;\n"
1988 +     " SELECT xmin INTO cx FROM public.external_handoff_currents WHERE tenant_id=NEW.tenant_id AND "
1989 +     "id=NEW.id;\n"
1990 +     " SELECT * INTO STRICT a FROM public.external_handoff_authorizations WHERE tenant_id=NEW.tenant_id AND "
1991 +     "id=cur.handoff_id;\n"
1992 +     " SELECT xmin INTO ax FROM public.external_handoff_authorizations WHERE tenant_id=NEW.tenant_id AND "
1993 +     "id=cur.handoff_id;\n"
1994 +     " SELECT * INTO STRICT i FROM public.external_delivery_intents WHERE tenant_id=NEW.tenant_id AND "
1995 +     "id=cur.intent_id;\n"
1996 +     " SELECT xmin INTO ix FROM public.external_delivery_intents WHERE tenant_id=NEW.tenant_id AND "
1997 +     "id=cur.intent_id;\n"
1998 +     " IF cur.receipt_count=0 THEN\n"
1999 +     '  IF cx IS DISTINCT FROM ax OR cx IS DISTINCT FROM ix OR cur.projection IS DISTINCT FROM \'{"status": '
2000 +     '"authorized","sent": {"stage": "sent","state": "not_recorded","active": [],"covered_scopes": '
2001 +     '[],"mismatches": []},"accepted": {"stage": "accepted","state": "not_recorded","active": '
2002 +     '[],"covered_scopes": [],"mismatches": []},"effective": {"stage": "effective","state": '
2003 +     '"not_recorded","active": [],"covered_scopes": [],"mismatches": []},"delivery_unknown": '
2004 +     'false,"rejected": false,"failed": false,"conflict": false,"network_send": false}\'::jsonb THEN\n'
2005 +     "   RAISE EXCEPTION 'Initial handoff Current records authorization without an external stage' USING "
2006 +     "ERRCODE='23514'; END IF;\n"
2007 +     " ELSE\n"
2008 +     "  IF NOT EXISTS(SELECT 1 FROM public.external_receipts r WHERE r.tenant_id=cur.tenant_id\n"
2009 +     "    AND r.id=cur.latest_receipt_id AND r.revision=cur.latest_receipt_revision AND "
2010 +     "r.sequence=cur.receipt_count\n"
2011 +     "    AND r.handoff_id=cur.handoff_id AND r.intent_id=cur.intent_id AND r.xmin=cx\n"
2012 +     "    AND r.projection_after=cur.projection AND r.projection_sha256=cur.projection_sha256) THEN\n"
2013 +     "   RAISE EXCEPTION 'Handoff Current needs its latest immutable receipt projection' USING "
2014 +     "ERRCODE='23514'; END IF;\n"
2015 +     " END IF;\n"
2016 +     " RETURN NULL;\n"
2017 +     "END;\n"
2018 +     "$external_handoff$",
2019 +     "CREATE FUNCTION public.protect_external_handoff_proof() RETURNS trigger\n"
2020 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
2021 +     "\n"
2022 +     "DECLARE old_scoped boolean=false; new_scoped boolean=false;\n"
2023 +     "BEGIN\n"
2024 +     " IF TG_OP<>'INSERT' THEN old_scoped=OLD.operation='integration.handoff.authorize'; END IF;\n"
2025 +     " IF TG_OP<>'DELETE' THEN new_scoped=NEW.operation='integration.handoff.authorize'; END IF;\n"
2026 +     " IF old_scoped OR new_scoped THEN\n"
2027 +     "  IF TG_OP='DELETE' THEN RAISE EXCEPTION 'External authorization proof history retained' USING "
2028 +     "ERRCODE='23514';\n"
2029 +     "  ELSIF TG_OP='INSERT' THEN\n"
2030 +     "   IF NEW.consumed IS DISTINCT FROM false THEN RAISE EXCEPTION 'External authorization proof starts "
2031 +     "unconsumed' USING ERRCODE='23514'; END IF;\n"
2032 +     "  ELSIF NOT(old_scoped AND new_scoped) OR OLD.consumed IS DISTINCT FROM false OR NEW.consumed IS "
2033 +     "DISTINCT FROM true\n"
2034 +     "   OR (to_jsonb(NEW)-'consumed') IS DISTINCT FROM (to_jsonb(OLD)-'consumed') THEN\n"
2035 +     "   RAISE EXCEPTION 'External authorization proof permits only original false to true' USING "
2036 +     "ERRCODE='23514'; END IF;\n"
2037 +     " END IF;\n"
2038 +     " IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;\n"
2039 +     "END;\n"
2040 +     "$external_handoff$",
2041 +     "CREATE FUNCTION public.require_external_handoff_transition() RETURNS trigger\n"
2042 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
2043 +     "\n"
2044 +     "BEGIN\n"
2045 +     " IF NEW.operation='integration.handoff.authorize' THEN\n"
2046 +     "  IF OLD.consumed IS DISTINCT FROM false OR NEW.consumed IS DISTINCT FROM true\n"
2047 +     "   OR (SELECT count(*) FROM public.external_handoff_authorizations a WHERE a.tenant_id=NEW.tenant_id\n"
2048 +     "    AND a.shared_proof_id=NEW.id AND a.operation=NEW.operation)<>1 THEN\n"
2049 +     "   RAISE EXCEPTION 'Consumed external T2 requires one actual authorization' USING ERRCODE='23514'; "
2050 +     "END IF;\n"
2051 +     " END IF;\n"
2052 +     " RETURN NULL;\n"
2053 +     "END;\n"
2054 +     "$external_handoff$",
2055 +     "CREATE FUNCTION public.protect_external_handoff_receipt() RETURNS trigger\n"
2056 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
2057 +     "\n"
2058 +     "DECLARE scoped boolean=false;\n"
2059 +     "BEGIN\n"
2060 +     " IF TG_OP<>'INSERT' THEN scoped=OLD.operation IN "
2061 +     "('integration.handoff.authorize','integration.receipt.record') OR OLD.subject_type IN "
2062 +     "('external_handoff','external_receipt'); END IF;\n"
2063 +     " IF TG_OP<>'DELETE' THEN scoped=scoped OR NEW.operation IN "
2064 +     "('integration.handoff.authorize','integration.receipt.record') OR NEW.subject_type IN "
2065 +     "('external_handoff','external_receipt'); END IF;\n"
2066 +     " IF scoped AND TG_OP<>'INSERT' THEN RAISE EXCEPTION 'External common receipt is immutable' USING "
2067 +     "ERRCODE='23514'; END IF;\n"
2068 +     " IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;\n"
2069 +     "END;\n"
2070 +     "$external_handoff$",
2071 +     "CREATE FUNCTION public.protect_external_handoff_member() RETURNS trigger\n"
2072 +     "LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $external_handoff$\n"
2073 +     "\n"
2074 +     "DECLARE scoped boolean=false; old_scoped boolean=false;\n"
2075 +     "BEGIN\n"
2076 +     " IF TG_OP<>'DELETE' THEN\n"
2077 +     "  SELECT EXISTS(SELECT 1 FROM public.action_receipts r WHERE r.tenant_id=NEW.tenant_id AND "
2078 +     "r.id=NEW.receipt_id\n"
2079 +     "   AND (r.operation IN ('integration.handoff.authorize','integration.receipt.record') OR "
2080 +     "r.subject_type IN ('external_handoff','external_receipt'))) INTO scoped;\n"
2081 +     " END IF;\n"
2082 +     " IF TG_OP<>'INSERT' THEN\n"
2083 +     "  SELECT EXISTS(SELECT 1 FROM public.action_receipts r WHERE r.tenant_id=OLD.tenant_id AND "
2084 +     "r.id=OLD.receipt_id\n"
2085 +     "   AND (r.operation IN ('integration.handoff.authorize','integration.receipt.record') OR "
2086 +     "r.subject_type IN ('external_handoff','external_receipt'))) INTO old_scoped;\n"
2087 +     " END IF;\n"
2088 +     " IF TG_OP<>'INSERT' AND (scoped OR old_scoped) THEN\n"
2089 +     "  IF TG_OP='UPDATE' AND TG_TABLE_NAME='outbox_events'\n"
2090 +     "   AND (to_jsonb(NEW)-ARRAY['delivered_at','lease_id','lease_until','attempts','last_error']) IS NOT "
2091 +     "DISTINCT FROM\n"
2092 +     "    (to_jsonb(OLD)-ARRAY['delivered_at','lease_id','lease_until','attempts','last_error']) THEN "
2093 +     "RETURN NEW; END IF;\n"
2094 +     "  RAISE EXCEPTION 'External original audit event or key is immutable' USING ERRCODE='23514'; END IF;\n"
2095 +     " IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;\n"
2096 +     "END;\n"
2097 +     "$external_handoff$",
2098 +     "CREATE FUNCTION public.require_external_handoff_member() RETURNS trigger\n"
