133  +     "  WHEN 'native_pilot_runs' THEN "
134  +     "ARRAY['build_id','lot_id','actual_configuration_id','engineering_configuration_id','process_id','publication_id']\n"
135  +     "  WHEN 'native_pilot_currents' THEN "
136  +     "ARRAY['pilot_id','latest_observation_id']\n"
137  +     "  WHEN 'native_pilot_observations' THEN "
138  +     "ARRAY['pilot_id','previous_observation_id']\n"
139  +     "  WHEN 'release_packages' THEN "
140  +     "ARRAY['previous_id']\n"
141  +     "  WHEN 'release_package_currents' THEN "
142  +     "ARRAY['version_id']\n"
143  +     "  WHEN 'release_decisions' THEN "
144  +     "ARRAY['package_id']\n"
145  +     "  WHEN 'release_policy_facts' THEN "
146  +     "ARRAY['previous_id']\n"
147  +     "  WHEN 'release_policy_currents' THEN "
148  +     "ARRAY['fact_id']\n"
149  +     "  ELSE ARRAY[]::text[] END;\n"
150  +     " FOREACH key IN ARRAY keys LOOP\n"
151  +     "  IF payload->>key IS NOT NULL THEN "
152  +     "links=array_append(links,(payload->>key)::uuid); "
153  +     "END IF;\n"
154  +     " END LOOP;\n"
155  +     " -- Publication's exact saved read set is a "
156  +     "validated Artifact relationship.\n"
157  +     " -- Do not scan its declaration, body, reason or "
158  +     "arbitrary JSON UUID values.\n"
159  +     " IF table_name IN "
160  +     "('manufacturing_baseline_publications','native_pilot_runs','native_pilot_observations','release_packages','release_decisions','release_policy_facts') "
161  +     "THEN\n"
162  +     "  FOR item IN SELECT value FROM "
163  +     "jsonb_array_elements(coalesce(payload->'required_source_read_set','[]')) "
164  +     "LOOP\n"
165  +     "   IF item->>'artifact_id' IS NOT NULL THEN\n"
166  +     "    "
167  +     "links=array_append(links,(item->>'artifact_id')::uuid);\n"
168  +     "   END IF;\n"
169  +     "  END LOOP;\n"
170  +     " END IF;\n"
171  +     " IF table_name IN "
172  +     "('native_pilot_runs','native_pilot_observations') "
173  +     "THEN\n"
174  +     "  FOR item IN SELECT value FROM "
175  +     "jsonb_array_elements(coalesce(payload#>'{material_snapshot,statistics,samples}','[]')) "
176  +     "LOOP\n"
177  +     "   IF item->>'id' IS NOT NULL THEN "
178  +     "links=array_append(links,(item->>'id')::uuid); END "
179  +     "IF;\n"
180  +     "  END LOOP;\n"
181  +     "  FOR item IN SELECT value FROM "
182  +     "jsonb_array_elements(coalesce(payload#>'{material_snapshot,statistics,issues}','[]')) "
183  +     "LOOP\n"
184  +     "   IF item->>'id' IS NOT NULL THEN "
185  +     "links=array_append(links,(item->>'id')::uuid); END "
186  +     "IF;\n"
187  +     "  END LOOP;\n"
188  +     "  "
189  +     "item=payload#>'{material_snapshot,statistics,resource,fact}';\n"
190  +     "  IF item->>'id' IS NOT NULL THEN "
191  +     "links=array_append(links,(item->>'id')::uuid); END "
192  +     "IF;\n"
193  +     " END IF;\n"
194  +     " IF table_name='release_packages' THEN\n"
195  +     "  -- FixedObject.ref is a closed, server-resolved "
196  +     "version reference, not arbitrary body UUID text.\n"
197  +     "  FOR item IN SELECT value FROM "
198  +     "jsonb_array_elements(coalesce(payload#>'{body,objects}','[]')) "
199  +     "LOOP\n"
200  +     "   container=item->'ref';\n"
201  +     "   IF "
202  +     "container->>'kind'=ANY(ARRAY['definition','engineering_configuration','process_revision','manufacturing_publication','test_run','pilot_run','issue','change','exception','artifact','work_instruction','control_plan','build_lot','line'])\n"
203  +     "    AND container->>'id' IS NOT NULL THEN "
204  +     "links=array_append(links,(container->>'id')::uuid); "
205  +     "END IF;\n"
206  +     "  END LOOP;\n"
207  +     " END IF;\n"
208  +     " IF table_name='release_policy_facts' THEN\n"
209  +     "  -- These are Closed DTO configuration references "
210  +     "fixed by the policy owner.\n"
211  +     "  FOREACH key IN ARRAY "
212  +     "ARRAY['definition','engineering_configuration','manufacturing_configuration'] "
213  +     "LOOP\n"
214  +     "   "
215  +     "container=payload#>ARRAY['material','subject_config',key];\n"
216  +     "   IF container->>'id' IS NOT NULL THEN "
217  +     "links=array_append(links,(container->>'id')::uuid); "
218  +     "END IF;\n"
219  +     "  END LOOP;\n"
220  +     " END IF;\n"
221  +     " -- These stored fields are validated Reference "
222  +     "containers. Do not feed the\n"
223  +     " -- whole row or arbitrary content into the "
224  +     "canonical Reference parser.\n"
225  +     " IF "
226  +     "table_name=ANY(ARRAY['proposals','proposal_item_versions','proposal_submissions',\n"
227  +     "  "
228  +     "'category_knowledge_entries','definition_specs']) "
229  +     "THEN\n"
230  +     "  FOREACH key IN ARRAY "
231  +     "ARRAY['source_refs','direct_source_refs','context_refs','baseline_claim_refs'] "
232  +     "LOOP\n"
233  +     "   links=links || "
234  +     "public.m3_lifecycle_typed_links(t,c,payload->key);\n"
235  +     "  END LOOP;\n"
236  +     " END IF;\n"
237  +     " -- Match ItemInput.content_schema and "
238  +     "category_service._references: only\n"
239  +     " -- commercial_target, voice, and competitor have "
240  +     "nested source contracts.\n"
241  +     " IF table_name='proposal_item_versions' AND "
242  +     "payload->>'kind'='commercial_target' THEN\n"
243  +     "  FOREACH key IN ARRAY "
244  +     "ARRAY['target_price','cost','volume'] LOOP\n"
245  +     "   links=links || "
246  +     "public.m3_lifecycle_typed_links(t,c,payload->'content'->key->'source');\n"
247  +     "  END LOOP;\n"
248  +     " ELSIF table_name='category_knowledge_entries' AND "
249  +     "payload->>'kind'='voice' THEN\n"
250  +     "  links=links || "
251  +     "public.m3_lifecycle_typed_links(t,c,payload->'content'->'representative_refs');\n"
252  +     " ELSIF table_name='category_knowledge_entries' AND "
253  +     "payload->>'kind'='competitor' THEN\n"
254  +     "  FOREACH key IN ARRAY "
255  +     "ARRAY['metrics','features','prices'] LOOP\n"
256  +     "   FOR item IN SELECT value FROM "
257  +     "jsonb_array_elements(coalesce(payload->'content'->key,'[]')) "
258  +     "LOOP\n"
259  +     "    links=links || "
260  +     "public.m3_lifecycle_typed_links(t,c,item->'source_ref');\n"
261  +     "   END LOOP;\n"
262  +     "  END LOOP;\n"
263  +     " END IF;\n"
264  +     " IF table_name='proposal_submissions' THEN\n"
265  +     "  container=payload->'frozen_document';\n"
266  +     "  FOREACH key IN ARRAY "
267  +     "ARRAY['source_refs','direct_source_refs','context_refs','baseline_claim_refs'] "
268  +     "LOOP\n"
269  +     "   links=links || "
270  +     "public.m3_lifecycle_typed_links(t,c,container->key);\n"
271  +     "  END LOOP;\n"
272  +     "  FOR item IN SELECT value FROM "
273  +     "jsonb_array_elements(coalesce(container->'items','[]')) "
274  +     "LOOP\n"
275  +     "   links=links || "
276  +     "public.m3_lifecycle_source_links(t,c,'proposal_item_versions',item-ARRAY['item_id','proposal_id']);\n"
277  +     "   -- The frozen read projection records actual "
278  +     "EvidenceLink provenance here.\n"
279  +     "   links=links || "
280  +     "public.m3_lifecycle_typed_links(t,c,item->'evidence_links');\n"
281  +     "  END LOOP;\n"
282  +     " ELSIF table_name='promotion_proofs' THEN\n"
283  +     "  FOR item IN SELECT value FROM "
284  +     "jsonb_array_elements(coalesce(payload->'source_item_refs','[]')) "
285  +     "LOOP\n"
286  +     "   IF item->>'item_id' IS NOT NULL THEN "
287  +     "links=array_append(links,(item->>'item_id')::uuid); "
288  +     "END IF;\n"
289  +     "  END LOOP;\n"
290  +     " END IF;\n"
291  +     " -- Exact persisted EvidenceLink targets "
292  +     "supplement these immutable versions.\n"
293  +     " -- Reverted links and withdrawn Claims still "
294  +     "retain the original historical\n"
295  +     " -- dependency; lifecycle cleanup must not erase "
296  +     "their audit source.\n"
297  +     " IF table_name='proposal_item_versions' AND "
298  +     "payload->>'item_id' IS NOT NULL THEN\n"
299  +     "  target_kind='proposal_item'; "
300  +     "referenced_target=(payload->>'item_id')::uuid;\n"
301  +     "  "
302  +     "referenced_version=(payload->>'version')::integer;\n"
303  +     " ELSIF table_name='category_knowledge_entries' AND "
304  +     "payload->>'id' IS NOT NULL THEN\n"
305  +     "  target_kind='knowledge_entry'; "
306  +     "referenced_target=(payload->>'id')::uuid;\n"
307  +     "  "
308  +     "referenced_version=(payload->>'version')::integer;\n"
309  +     " ELSIF table_name='definition_specs' AND "
310  +     "payload->>'id' IS NOT NULL THEN\n"
311  +     "  target_kind='definition_spec'; "
312  +     "referenced_target=(payload->>'id')::uuid;\n"
313  +     "  SELECT revision INTO referenced_version FROM "
314  +     "public.definition_revisions\n"
315  +     "   WHERE tenant_id=t AND category_id=c AND "
316  +     "id=(payload->>'definition_id')::uuid;\n"
317  +     " END IF;\n"
318  +     " IF referenced_target IS NOT NULL AND "
319  +     "referenced_version IS NOT NULL THEN\n"
320  +     "  SELECT "
321  +     "coalesce(array_agg(link.evidence_id),'{}') INTO "
322  +     "extra FROM public.evidence_links link\n"
323  +     "   WHERE link.tenant_id=t AND link.category_id=c "
324  +     "AND link.target_type=target_kind\n"
325  +     "    AND link.target_id=referenced_target AND "
326  +     "link.target_version=referenced_version;\n"
327  +     "  links=links || extra;\n"
328  +     " END IF;\n"
329  +     " -- Child source rows point to their parent, "
330  +     "whereas dependency traversal needs\n"
331  +     " -- the parent's fixed source children as well. "
332  +     "Keep the actual relational edge.\n"
333  +     " IF table_name='definition_revisions' THEN\n"
334  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
335  +     "FROM (\n"
336  +     "   SELECT id FROM public.definition_sources WHERE "
337  +     "tenant_id=t AND category_id=c\n"
338  +     "    AND definition_id=(payload->>'id')::uuid\n"
339  +     "   UNION ALL SELECT id FROM "
340  +     "public.definition_specs WHERE tenant_id=t AND "
341  +     "category_id=c\n"
342  +     "    AND definition_id=(payload->>'id')::uuid\n"
343  +     "  ) children;\n"
344  +     "  links=links || extra;\n"
345  +     " ELSIF table_name='proposals' THEN\n"
346  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
347  +     "FROM public.proposal_item_versions\n"
348  +     "   WHERE tenant_id=t AND category_id=c AND "
349  +     "proposal_id=(payload->>'id')::uuid;\n"
350  +     "  links=links || extra;\n"
351  +     " ELSIF table_name='proposal_items' THEN\n"
352  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
353  +     "FROM public.proposal_item_versions\n"
354  +     "   WHERE tenant_id=t AND category_id=c AND "
355  +     "item_id=(payload->>'id')::uuid;\n"
356  +     "  links=links || extra;\n"
357  +     " ELSIF table_name='product_target_segments' THEN\n"
358  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
359  +     "FROM public.category_knowledge_entries\n"
360  +     "   WHERE tenant_id=t AND category_id=c AND "
361  +     "lineage_id=(payload->>'segment_lineage_id')::uuid\n"
362  +     "    AND "
363  +     "version=(payload->>'segment_version')::integer;\n"
364  +     "  links=links || extra;\n"
365  +     " ELSIF table_name='parameter_current' THEN\n"
366  +     "  SELECT coalesce(array_agg(id),'{}') INTO extra "
367  +     "FROM public.parameter_versions\n"
368  +     "   WHERE tenant_id=t AND category_id=c AND "
369  +     "parameter_id=(payload->>'parameter_id')::uuid\n"
370  +     "    AND "
371  +     "version=(payload->>'current_version')::integer;\n"
372  +     "  links=links || extra;\n"
373  +     " END IF;\n"
374  +     " RETURN links;\n"
375  +     "END;\n"
376  +     "$function$\n",
377  +     "m3_lifecycle_row_links(uuid,uuid,text,jsonb)": "CREATE OR REPLACE FUNCTION "
378  +     "public.m3_lifecycle_row_links(t uuid, c uuid, "
379  +     "table_name text, payload jsonb)\n"
380  +     " RETURNS uuid[]\n"
381  +     " LANGUAGE plpgsql\n"
382  +     " STABLE SECURITY DEFINER\n"
383  +     " SET search_path TO 'pg_catalog', 'public', "
384  +     "'pg_temp'\n"
385  +     "AS $function$\n"
386  +     "DECLARE links uuid[]; key text; keys text[];\n"
387  +     "BEGIN\n"
388  +     " "
389  +     "links=public.m3_lifecycle_source_links(t,c,table_name,payload);\n"
390  +     " -- Only the infrequent retention summary needs "
391  +     "host/reverse relationships.\n"
392  +     " -- They must not turn a source-free item INSERT into "
393  +     "a proposal-history scan.\n"
394  +     " keys=CASE table_name\n"
395  +     "  WHEN 'definition_sources' THEN "
396  +     "ARRAY['definition_id']\n"
397  +     "  WHEN 'definition_specs' THEN "
398  +     "ARRAY['definition_id']\n"
399  +     "  WHEN 'proposal_items' THEN ARRAY['proposal_id']\n"
400  +     "  WHEN 'proposal_item_versions' THEN "
401  +     "ARRAY['proposal_id','item_id']\n"
402  +     "  WHEN 'proposal_sources' THEN ARRAY['proposal_id']\n"
403  +     "  WHEN 'proposal_submissions' THEN "
404  +     "ARRAY['proposal_id']\n"
405  +     "  WHEN 'proposal_decisions' THEN "
406  +     "ARRAY['proposal_id','created_definition_id']\n"
407  +     "  WHEN 'evidence_links' THEN ARRAY['target_id']\n"
408  +     "  WHEN 'manufacturing_baseline_publications' THEN "
409  +     "ARRAY['project_id']\n"
410  +     "  WHEN 'manufacturing_publication_currents' THEN "
411  +     "ARRAY['series_id']\n"
412  +     "  WHEN 'manufacturing_publication_documents' THEN "
413  +     "ARRAY['publication_id']\n"
414  +     "  WHEN 'native_pilot_runs' THEN ARRAY['project_id']\n"
415  +     "  WHEN 'native_pilot_currents' THEN "
416  +     "ARRAY['pilot_id']\n"
417  +     "  WHEN 'native_pilot_observations' THEN "
418  +     "ARRAY['pilot_id']\n"
419  +     "  WHEN 'release_packages' THEN "
420  +     "ARRAY['project_id','series_id']\n"
421  +     "  WHEN 'release_package_currents' THEN "
422  +     "ARRAY['series_id']\n"
423  +     "  WHEN 'release_decisions' THEN ARRAY['package_id']\n"
424  +     "  WHEN 'release_policy_facts' THEN "
425  +     "ARRAY['project_id','series_id']\n"
426  +     "  WHEN 'release_policy_currents' THEN "
427  +     "ARRAY['series_id']\n"
428  +     "  ELSE ARRAY[]::text[] END;\n"
429  +     " FOREACH key IN ARRAY keys LOOP\n"
430  +     "  IF payload->>key IS NOT NULL THEN "
431  +     "links=array_append(links,(payload->>key)::uuid); END "
432  +     "IF;\n"
433  +     " END LOOP;\n"
434  +     " RETURN links;\n"
435  +     "END;\n"
436  +     "$function$\n",
437  +     "protect_object_audience_target()": "CREATE OR REPLACE FUNCTION "
438  +     "public.protect_object_audience_target()\n"
439  +     " RETURNS trigger\n"
440  +     " LANGUAGE plpgsql\n"
441  +     " SET search_path TO 'pg_catalog', 'public', 'pg_temp'\n"
442  +     "AS $function$\n"
443  +     "DECLARE value jsonb; typ text; own_col text; model_col text;\n"
444  +     " t uuid; c uuid; sid uuid; expected_owner uuid; actual_owner "
445  +     "uuid; model uuid;\n"
446  +     ' owners jsonb=\'{"action_receipts": "requester_id", '
447  +     '"actual_configurations": "owner_id", "artifact_versions": '
448  +     '"owner_id", "bom_revisions": "owner_id", '
449  +     '"build_authorization_decisions": "owner_id", '
450  +     '"build_execution_assessments": "owner_id", "build_lots": '
451  +     '"owner_id", "build_operational_facts": "owner_id", '
452  +     '"build_readiness": "owner_id", "build_starts": "owner_id", '
453  +     '"builds": "owner_id", "capa_current_observations": "owner_id", '
454  +     '"capa_current_verification_rules": "owner_id", '
455  +     '"capa_named_verification_reviews": "owner_id", '
456  +     '"capa_observation_facts": "owner_id", "capa_remediation_links": '
457  +     '"owner_id", "capa_verification_evidence": "owner_id", '
458  +     '"capa_verification_rule_facts": "owner_id", '
459  +     '"change_approval_records": "owner_id", "change_graph_captures": '
460  +     '"owner_id", "change_implementation_captures": "owner_id", '
461  +     '"change_implementation_records": "owner_id", '
462  +     '"change_order_records": "owner_id", "change_request_versions": '
463  +     '"owner_id", "controlled_change_coverage_currents": "owner_id", '
464  +     '"controlled_change_coverage_facts": "owner_id", '
465  +     '"controlled_change_policy_currents": "owner_id", '
466  +     '"controlled_change_policy_facts": "owner_id", '
467  +     '"controlled_change_selection_currents": "owner_id", '
468  +     '"controlled_change_selection_facts": "owner_id", '
469  +     '"cost_estimates": "owner_id", "cost_input_snapshots": "owner_id", '
470  +     '"cost_source_captures": "owner_id", "definition_revisions": '
471  +     '"owner_id", "engineering_configurations": "owner_id", '
472  +     '"manufacturing_preparation_currents": "owner_id", '
473  +     '"manufacturing_preparation_versions": "owner_id", '
474  +     '"measurement_import_captures": "owner_id", "parts": "owner_id", '
475  +     '"plan_proposals": "owner_id", "plan_revisions": "owner_id", '
476  +     '"process_revisions": "owner_id", "product_variants": "owner_id", '
477  +     '"products": "owner_id", "professional_authority_facts": '
478  +     '"owner_id", "projects": "owner_id", "quality_issue_versions": '
479  +     '"owner_id", "quality_policy_facts": "owner_id", '
480  +     '"sample_allocations": "owner_id", "sample_readiness_facts": '
481  +     '"owner_id", "sample_run_usages": "owner_id", "sample_units": '
482  +     '"owner_id", "supply_kit_projections": "owner_id", '
483  +     '"supply_snapshots": "owner_id", "supply_source_captures": '
484  +     '"owner_id", "test_measurements": "owner_id", '
485  +     '"test_resource_facts": "owner_id", "test_resource_reservations": '
486  +     '"owner_id", "test_result_actions": "owner_id", '
487  +     '"test_result_projections": "owner_id", "uploaded_originals": '
488  +     '"owner_id", "variant_revisions": "owner_id", '
489  +     '"verification_actual_method_applicabilities": "owner_id", '
490  +     '"verification_actual_method_batches": "owner_id", '
491  +     '"verification_formal_requests": "owner_id", '
492  +     '"verification_handoff_facts": "owner_id", '
493  +     '"verification_launch_facts": "owner_id", '
494  +     '"verification_method_applicabilities": "owner_id", '
495  +     '"verification_preparations": "owner_id", '
496  +     '"verification_run_identities": "owner_id", '
497  +     '"verification_run_versions": "owner_id", '
498  +     '"verification_window_proposals": "owner_id", "proposals": '
499  +     '"owner_id", "claims": "human_owner_id"}\'::jsonb;\n'
500  +     "BEGIN\n"
501  +     " IF TG_OP='DELETE' THEN value=to_jsonb(OLD); ELSE "
502  +     "value=to_jsonb(NEW); END IF;\n"
503  +     " IF TG_OP='UPDATE' AND\n"
504  +     "   "
505  +     "ROW(NEW.tenant_id,NEW.category_id,NEW.object_type,NEW.subject_id,NEW.owner_id)\n"
506  +     "   IS DISTINCT FROM "
507  +     "ROW(OLD.tenant_id,OLD.category_id,OLD.object_type,OLD.subject_id,OLD.owner_id)\n"
508  +     " THEN RAISE EXCEPTION 'audience identity cannot be reassigned' "
509  +     "USING ERRCODE='23514'; END IF;\n"
510  +     " typ=value->>'object_type'; own_col=owners->>typ;\n"
511  +     " t=(value->>'tenant_id')::uuid; c=(value->>'category_id')::uuid;\n"
512  +     " sid=(value->>'subject_id')::uuid; "
513  +     "expected_owner=(value->>'owner_id')::uuid;\n"
514  +     " IF own_col IS NULL THEN\n"
515  +     "  RAISE EXCEPTION 'audience target unavailable' USING "
516  +     "ERRCODE='23514';\n"
517  +     " END IF;\n"
518  +     " IF typ='variant_revisions' THEN\n"
519  +     "  IF "
520  +     "m3_lock_variant_revision_audience_target(t,c,sid,expected_owner) "
521  +     "IS DISTINCT FROM true THEN\n"
522  +     "   RAISE EXCEPTION 'audience target unavailable' USING "
523  +     "ERRCODE='23514';\n"
524  +     "  END IF;\n"
525  +     "  IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
526  +     " END IF;\n"
527  +     " IF typ='product_variants' THEN\n"
528  +     "  IF m3_lock_variant_audience_target(t,c,sid,expected_owner) IS "
529  +     "DISTINCT FROM true THEN\n"
530  +     "   RAISE EXCEPTION 'audience target unavailable' USING "
531  +     "ERRCODE='23514';\n"
532  +     "  END IF;\n"
533  +     "  IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\n"
534  +     " END IF;\n"
535  +     " model_col=CASE WHEN typ='products' THEN 'id' WHEN "
536  +     "typ='proposals' THEN 'baseline_product_id' ELSE 'product_id' "
537  +     "END;\n"
538  +     " EXECUTE format('SELECT %I,%I FROM public.%I WHERE tenant_id=$1 "
539  +     "AND category_id=$2 AND id=$3',\n"
540  +     "                own_col,model_col,typ) INTO actual_owner,model "
541  +     "USING t,c,sid;\n"
542  +     " IF actual_owner IS DISTINCT FROM expected_owner THEN\n"
543  +     "  RAISE EXCEPTION 'audience target unavailable' USING "
544  +     "ERRCODE='23514';\n"
