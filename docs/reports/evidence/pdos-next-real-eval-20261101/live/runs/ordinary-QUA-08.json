        "scope_note": "一般性质量术语解释，未查询公司资料，未引用任何公司案例。",
        "definitions": [
          {
            "term": "纠正 / correction",
            "meaning": "对已经发生的具体不合格做处置，使该产品/批次恢复到符合要求的状态。",
            "examples": [
              "返工",
              "返修",
              "退货",
              "换货",
              "重新检验后放行"
            ],
            "addressed_question": "这一次的不合格怎么处理"
          },
          {
            "term": "纠正措施 / corrective action",
            "meaning": "分析并消除产生不合格的根本原因，防止同类问题再次发生。",
            "elements": [
              "原因分析",
              "消除或降低原因的措施",
              "效果验证（是否防再发生）"
            ],
            "addressed_question": "为什么会出这个问题，怎么让它不再出"
          }
        ],
        "key_relation": "纠正作用于结果，纠正措施作用于原因；纠正措施通常建立在纠正已经完成的前提之上。",
        "uncertainties": [],
        "common_confusion": "把返工/换货当作纠正措施——那只是纠正；如果原因没被消除，问题会复发。"
      },
      "status": "completed",
      "summary": "纠正（correction）是处置已经发生的那个不合格本身，让这一件/这一批回到符合要求的状态，比如返工、返修、退货、换货。纠正措施（corrective action）是针对导致不合格产生的原因做分析和整改，消除原因，避免同类问题再发生。一句话：纠正处理“这次的产品”，纠正措施处理“导致出错的机制”；前者是对已发现不合格的处置，后者要求有原因分析和防再发生的验证。",
      "questions": [],
      "unfinished": []
    },
