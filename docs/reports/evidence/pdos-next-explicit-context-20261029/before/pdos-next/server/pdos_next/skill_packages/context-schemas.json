            "required": [
              "receipt_id",
              "operation",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "completed_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              }
            },
            "required": [
              "event_id",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "version",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "citation_directory": {
          "type": "object",
          "properties": {
            "tool": {
              "const": "assistant.citations.read"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "tool",
            "has_more",
            "next_cursor"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "context_incomplete": {
          "type": "boolean"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_preferences": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "current",
                "same_category"
              ]
            },
            "include_customer_private": {
              "type": "boolean"
            }
          },
          "required": [
            "scope",
            "include_customer_private"
          ],
          "additionalProperties": false
        },
        "search_context": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "personal",
                "category",
                "project",
                "proposal"
              ]
            },
            "label": {
              "type": "string"
            },
            "scoped": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "label",
            "scoped"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "revision",
        "session_id",
        "root_goal",
        "current_goal",
        "constraints",
        "exclusions",
        "focus_objects",
        "completed",
        "completed_count",
        "candidates",
        "unfinished",
        "questions",
        "skills",
        "citations",
        "notes",
        "estimated_tokens",
        "context_incomplete",
        "missing"
      ],
      "additionalProperties": false
    }
  },
