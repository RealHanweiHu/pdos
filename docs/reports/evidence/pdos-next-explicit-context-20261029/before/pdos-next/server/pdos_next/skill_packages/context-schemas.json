        "visibility": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "visibility"
      ],
      "additionalProperties": false
    },
    "work_state": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_goal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "run_id",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "current_goal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "run_id",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "run_id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "focus_objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "version": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "run_id": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "version",
              "run_id"
            ],
            "additionalProperties": false
          }
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "receipt_id": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              }
