          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "maturity": {
          "type": "object",
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        },
        "submission": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        },
        "decision": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        }
