    "item": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "type": "object",
          "additionalProperties": true,
          "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "origin": {
          "type": "string"
        },
        "writer_id": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_value": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "claim_states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        }
      },
      "required": [
        "item_id",
        "version",
        "kind",
        "content",
        "source_refs",
        "origin",
        "human_value",
        "removed"
      ],
      "additionalProperties": false
