    "research_memory": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "row_count": {
          "type": "integer"
        },
        "ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact authorized domain payload; its own domain schema and source guards remain authoritative."
          }
        }
      },
      "required": [
        "job_id",
        "status",
        "snapshots",
        "row_count"
