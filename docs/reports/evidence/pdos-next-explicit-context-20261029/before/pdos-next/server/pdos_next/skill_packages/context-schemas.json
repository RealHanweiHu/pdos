          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "product": {
          "$ref": "#/$defs/product"
        },
        "conversation": {
          "$ref": "#/$defs/conversation"
        },
        "proposal": {
          "$ref": "#/$defs/proposal"
        },
        "project": {
          "$ref": "#/$defs/project"
        },
        "work_state": {
          "$ref": "#/$defs/work_state"
        }
      },
      "required": [
