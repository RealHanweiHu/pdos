        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "original_record": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
