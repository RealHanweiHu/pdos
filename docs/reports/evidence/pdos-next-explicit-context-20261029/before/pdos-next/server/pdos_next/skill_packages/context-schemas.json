    "category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "purpose"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "visibility": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "visibility"
      ],
      "additionalProperties": false
