      "properties": {
        "summary": {
          "type": "string"
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "research": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/research_memory"
          }
