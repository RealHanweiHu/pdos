+    explicit = Schedule.model_validate({**raw, "calendar": None})
+    assert implicit.model_dump(mode="json") == explicit.model_dump(mode="json") == raw
+    assert implicit.due(dt("2026-11-01T13:00:00Z")) == dt("2026-11-01T13:00:00Z")
