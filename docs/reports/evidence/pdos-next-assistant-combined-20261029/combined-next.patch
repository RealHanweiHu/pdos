+                             "history": 1000, "loop": 1000},
+                "cleanup": {"applied": True, "saved_tokens": 6000,
+                            "minimum_tokens": 5200, "reason": "minimum_reached"},
+                "reductions": [{"kind": "older_tool_result", "field": "messages[2]",
