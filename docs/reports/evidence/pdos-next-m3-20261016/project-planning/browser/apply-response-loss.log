  captured = {scenario:"browser_simulated_response_loss_after_actual_commit",backend_status:response.status(),command_id:body.command_id,idempotency_key:body.idempotency_key,project_id:body.payload.project_id,receipt_id:receipt.id,plan_id:receipt.subject_id};
