# ============================================================
# PDOS 生产环境变量模板（部署到 ECS 8.140.197.68 时使用）
# 用法: 在服务器上 cp .env.production.example .env.production 并填写
# 与 CEHub / ERP 看板同一套基础设施, 分库分账号隔离
# .env.production 永不入库
# ============================================================

# ---------- 数据库: 复用 RDS 实例, 新库 pdos + 专用账号 ----------
# 一次性准备（RDS 控制台或用高权限账号执行）:
#   1. 创建账号 pdos_app（普通账号, 强密码）
#   2. 创建数据库 pdos, owner 设为 pdos_app
#   3. 验证 pgvector: 在 pdos 库执行 CREATE EXTENSION IF NOT EXISTS vector;
#      （若报错不支持 → 回退方案: ECS 上 compose 起 pgvector/pgvector:pg16 容器）
# ECS 内网 IP 172.19.142.146 已在白名单, 无需再加
# CA 证书: certs/ApsaraDB-CA-Chain.pem（从 CEHub 仓库拷贝, 公开 CA 链）
DATABASE_URL=postgresql://pdos_app:<密码>@pgm-2ze135h6045td5ujvo.pg.rds.aliyuncs.com:5432/pdos?sslmode=verify-full&sslrootcert=/app/certs/ApsaraDB-CA-Chain.pem
# Agent 运行时必须使用两个独立最小权限角色，禁止复用上面的 pdos_app DSN
# 角色创建、授权与验证见 docs/runbooks/agent-runtime-database-security.md
PDOS_WORKER_DATABASE_URL=postgresql://pdos_worker:<独立密码>@pgm-2ze135h6045td5ujvo.pg.rds.aliyuncs.com:5432/pdos?sslmode=verify-full&sslrootcert=/app/certs/ApsaraDB-CA-Chain.pem
PDOS_AGENT_DATABASE_URL=postgresql://pdos_agent:<另一独立密码>@pgm-2ze135h6045td5ujvo.pg.rds.aliyuncs.com:5432/pdos?sslmode=verify-full&sslrootcert=/app/certs/ApsaraDB-CA-Chain.pem

# ---------- LLM Gateway（多供应商候选池，只需填写要启用供应商的 API key） ----------
# 候选预设（供应商 | 协议 | base_url | 默认候选模型）:
#   minimax | openai-compatible | https://api.minimaxi.com/v1 | MiniMax-M3
#   deepseek | openai-compatible | https://api.deepseek.com | deepseek-v4-flash
#   glm | openai-compatible | https://open.bigmodel.cn/api/paas/v4 | glm-5.2
#   openai | openai-compatible | https://api.openai.com/v1 | gpt-5.1
#   anthropic | native | SDK default | claude-sonnet-5
#   openrouter | openai-compatible | https://openrouter.ai/api/v1 | openai/gpt-5.2
#   opencode_go | openai-compatible | https://opencode.ai/zen/go/v1 | deepseek-v4-flash
# 当前默认供应商为 MiniMax 国内版
PDOS_LLM_PROVIDER=minimax
PDOS_LLM_BASE_URL=https://api.minimaxi.com/v1
PDOS_LLM_API_KEY=
PDOS_LLM_MODEL=MiniMax-M3

# 备选供应商只需填写对应 key；通过 golden-case 后才进入租户模型下拉
# 当前默认供应商继续使用上面的 PDOS_LLM_API_KEY，无需重复填写
PDOS_LLM_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
PDOS_LLM_MINIMAX_MODEL=MiniMax-M3
PDOS_LLM_MINIMAX_API_KEY=

PDOS_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
PDOS_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
PDOS_LLM_DEEPSEEK_API_KEY=

PDOS_LLM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PDOS_LLM_GLM_MODEL=glm-5.2
PDOS_LLM_GLM_API_KEY=

PDOS_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
PDOS_LLM_OPENAI_MODEL=gpt-5.1
PDOS_LLM_OPENAI_API_KEY=

PDOS_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
PDOS_LLM_ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

PDOS_LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PDOS_LLM_OPENROUTER_MODEL=openai/gpt-5.2
PDOS_LLM_OPENROUTER_API_KEY=

# OpenCode Go 第一版仅开放官方 /chat/completions 模型；/messages 与 /responses 暂不接入
PDOS_LLM_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
PDOS_LLM_OPENCODE_GO_MODEL=deepseek-v4-flash
PDOS_LLM_OPENCODE_GO_API_KEY=
PDOS_AI_DAILY_TOKEN_BUDGET=2000000

# ---------- 认证 ----------
# 生成: openssl rand -base64 32（与开发环境不同的值）
JWT_SECRET=
JWT_ISSUER=pdos-api
JWT_AUDIENCE=pdos-web
JWT_ACCESS_TOKEN_MINUTES=30
# Next.js BFF 到 compose 内网 FastAPI；不要使用 NEXT_PUBLIC_ 前缀
PDOS_API_INTERNAL_URL=http://api:8000

# ---------- 对象存储: 阿里云 OSS ----------
# 一次性准备: OSS 控制台新建桶 pdos-files（应用凭据无建桶权限, 必须预建）
S3_ENDPOINT=<OSS endpoint, 同 CEHub .env.production 的写法>
S3_REGION=<OSS region>
S3_BUCKET=pdos-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- 端口（Caddy 反代 pdos.beepump.io → 127.0.0.1:3002） ----------
APP_PORT=3002
# 每次发布填待部署的 git commit SHA；用于保留可回滚镜像
PDOS_IMAGE_TAG=<git commit SHA>
